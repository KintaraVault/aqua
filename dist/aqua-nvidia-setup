#!/bin/sh
# aqua-nvidia-setup — enable kernel modesetting for the NVIDIA proprietary/open driver.
#
# Every Wayland compositor (Aqua included) needs nvidia_drm.modeset=1. Drivers before 560
# (e.g. the 550 LTS series shipped by Debian 13 / Ubuntu 24.04) leave it off by default,
# and a desktop session has no rights to change boot settings, so this runs as root —
# called by dist/install.sh, or by hand / through pkexec:
#
#   sudo aqua-nvidia-setup            configure (idempotent); exit 0 = nothing to do or done
#   sudo aqua-nvidia-setup --check    only report; exit 0 = OK, 1 = needs setup
#   sudo aqua-nvidia-setup --remove   undo
#   options: --no-initramfs  --no-bootloader  --quiet
#
# What it does:
#   * /etc/modprobe.d/nvidia-aqua.conf: options nvidia_drm modeset=1 [fbdev=1 on >= 545]
#     (+ NVreg_PreserveVideoMemoryAllocations=1 when the nvidia-suspend services exist,
#     which it then enables);
#   * the same on the kernel command line (GRUB via update-grub / grub-mkconfig / grubby,
#     systemd-boot via /etc/kernel/cmdline and loader entries) so it also applies when the
#     module is loaded from the initramfs before /etc is mounted;
#   * regenerates the initramfs (mkinitcpio / dracut / update-initramfs).
# A reboot is needed afterwards (exit status 0, "reboot required" printed).
set -eu

MODE=apply
DO_INITRAMFS=1
DO_BOOT=1
QUIET=0
for a in "$@"; do
    case "$a" in
        --check) MODE=check ;;
        --remove) MODE=remove ;;
        --no-initramfs) DO_INITRAMFS=0 ;;
        --no-bootloader) DO_BOOT=0 ;;
        --quiet|-q) QUIET=1 ;;
        -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: $a" >&2; exit 2 ;;
    esac
done

say()  { [ "$QUIET" -eq 1 ] || printf '  %s\n' "$*"; }
warn() { printf '  ! %s\n' "$*" >&2; }

CONF=/etc/modprobe.d/nvidia-aqua.conf
MARK="# generated by aqua-nvidia-setup"

# ------------------------------------------------------------------ detection
driver_version() {
    if [ -r /sys/module/nvidia/version ]; then
        cat /sys/module/nvidia/version
        return
    fi
    if command -v modinfo >/dev/null 2>&1; then
        for m in nvidia nvidia-current nvidia-open; do
            v=$(modinfo -F version "$m" 2>/dev/null | head -n 1 || true)
            [ -n "$v" ] && { echo "$v"; return; }
        done
    fi
    # Debian names the module packages nvidia-kernel-dkms / nvidia-open-kernel-dkms
    if command -v dpkg-query >/dev/null 2>&1; then
        v=$(dpkg-query -W -f '${Version}\n' nvidia-kernel-dkms nvidia-open-kernel-dkms nvidia-driver 2>/dev/null | grep -v '^$' | head -n 1 || true)
        [ -n "$v" ] && { echo "${v#*:}"; return; }
    fi
    echo ""
}

VERSION=${AQUA_NVIDIA_VERSION:-$(driver_version)}  # override for tests
MAJOR=$(printf '%s' "$VERSION" | sed -n 's/^\([0-9][0-9]*\).*/\1/p')
[ -n "$MAJOR" ] || MAJOR=0

has_nvidia_gpu() {
    [ -d /sys/module/nvidia ] && return 0
    for d in /sys/bus/pci/devices/*; do
        [ -r "$d/vendor" ] && [ -r "$d/class" ] || continue
        # 0x10de = NVIDIA, class 0x03xxxx = display controller
        if [ "$(cat "$d/vendor")" = 0x10de ] && case "$(cat "$d/class")" in 0x03*) true ;; *) false ;; esac; then
            return 0
        fi
    done
    return 1
}

active_modeset() {
    if [ -n "${AQUA_NVIDIA_MODESET:-}" ]; then echo "$AQUA_NVIDIA_MODESET"; return; fi  # tests
    cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null || echo "?"
}

if [ "$MODE" != remove ]; then
    if [ "$MAJOR" -eq 0 ]; then
        if has_nvidia_gpu; then
            say "NVIDIA GPU found but the proprietary/open NVIDIA driver is not installed (nouveau needs no setup)."
        else
            say "No NVIDIA driver — nothing to do."
        fi
        exit 0
    fi
fi

params() {
    p="nvidia_drm modeset=1"
    # fbdev exists since 545; on 550 it is off by default (black VTs, no fbcon handover)
    [ "$MAJOR" -ge 545 ] && p="$p fbdev=1"
    echo "$p"
}
cmdline_args() {
    a="nvidia-drm.modeset=1"
    [ "$MAJOR" -ge 545 ] && a="$a nvidia-drm.fbdev=1"
    echo "$a"
}

# configured = our file (or any modprobe.d / cmdline setting) enables modeset
configured() {
    grep -Rqs -E '^[[:space:]]*options[[:space:]]+nvidia[-_]drm[[:space:]].*modeset=1' /etc/modprobe.d /usr/lib/modprobe.d 2>/dev/null && return 0
    grep -qs -E 'nvidia[-_]drm\.modeset=1' /proc/cmdline && return 0
    return 1
}

if [ "$MODE" = check ]; then
    m=$(active_modeset)
    say "NVIDIA driver $VERSION, nvidia_drm.modeset=$m"
    case "$m" in
        Y|1) exit 0 ;;
    esac
    if configured; then
        say "modesetting is configured — reboot to activate it"
        exit 0
    fi
    say "modesetting is OFF (drivers before 560 do not enable it): run  sudo aqua-nvidia-setup"
    exit 1
fi

[ "$(id -u)" -eq 0 ] || { echo "aqua-nvidia-setup: must run as root (sudo / pkexec)" >&2; exit 1; }

CHANGED=0

# ------------------------------------------------------------------ initramfs
regen_initramfs() {
    [ "$DO_INITRAMFS" -eq 1 ] || return 0
    if command -v mkinitcpio >/dev/null 2>&1; then
        say "regenerating initramfs (mkinitcpio -P)…"
        mkinitcpio -P >/dev/null 2>&1 || warn "mkinitcpio -P failed — run it by hand"
    elif command -v dracut >/dev/null 2>&1; then
        say "regenerating initramfs (dracut --regenerate-all)…"
        dracut --force --regenerate-all >/dev/null 2>&1 || warn "dracut --regenerate-all failed — run it by hand"
    elif command -v update-initramfs >/dev/null 2>&1; then
        say "regenerating initramfs (update-initramfs -u -k all)…"
        update-initramfs -u -k all >/dev/null 2>&1 || warn "update-initramfs failed — run it by hand"
    elif command -v booster >/dev/null 2>&1; then
        say "booster images are rebuilt on the next kernel update; rebuilding now…"
        for k in /usr/lib/modules/*; do booster build --force --kernel-version "${k##*/}" "/boot/booster-${k##*/}.img" >/dev/null 2>&1 || true; done
    fi
}

# ----------------------------------------------------------------- bootloader
# add/remove our args in a KEY="..." assignment. Returns 1 when the key is missing;
# sets FILE_CHANGED=1 when the file was modified.
edit_assign() { # file key add|remove
    f=$1; key=$2; mode=$3
    [ -f "$f" ] || return 1
    line=$(grep -E "^${key}=" "$f" | tail -n 1 || true)
    [ -n "$line" ] || return 1
    val=$(printf '%s' "$line" | sed -E "s/^${key}=//; s/^\"//; s/\"$//")
    new=$(printf '%s' "$val" | sed -E 's/(^| )nvidia[-_]drm\.(modeset|fbdev)=[^ ]*//g; s/^ +//; s/ +$//')
    if [ "$mode" = add ]; then new="$new $(cmdline_args)"; new=${new# }; fi
    [ "$new" = "$val" ] && return 0
    [ -f "$f.aqua-bak" ] || cp -p "$f" "$f.aqua-bak" 2>/dev/null || true
    esc=$(printf '%s' "$new" | sed 's/[&|\\]/\\&/g')
    sed -i -E "s|^${key}=.*|${key}=\"${esc}\"|" "$f"
    FILE_CHANGED=1
    return 0
}

# GRUB defaults: our args go into GRUB_CMDLINE_LINUX_DEFAULT (else GRUB_CMDLINE_LINUX),
# never both
edit_grub_default() { # add|remove
    FILE_CHANGED=0
    f=/etc/default/grub
    if [ "$1" = add ] && grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$f"; then
        edit_assign "$f" GRUB_CMDLINE_LINUX_DEFAULT add || true
        edit_assign "$f" GRUB_CMDLINE_LINUX remove || true
    elif [ "$1" = add ]; then
        edit_assign "$f" GRUB_CMDLINE_LINUX add || true
    else
        edit_assign "$f" GRUB_CMDLINE_LINUX_DEFAULT remove || true
        edit_assign "$f" GRUB_CMDLINE_LINUX remove || true
    fi
    [ "$FILE_CHANGED" -eq 1 ]
}

edit_plain() { # file mode — whole file is the cmdline (/etc/kernel/cmdline)
    f=$1; mode=$2
    [ -f "$f" ] || return 1
    val=$(tr '\n' ' ' < "$f" | sed 's/ *$//')
    new=$(printf '%s' "$val" | sed -E 's/(^| )nvidia[-_]drm\.(modeset|fbdev)=[^ ]*//g; s/^ +//; s/ +$//')
    if [ "$mode" = add ]; then new="$new $(cmdline_args)"; new=${new# }; fi
    [ "$new" = "$val" ] && return 1
    printf '%s\n' "$new" > "$f"
    return 0
}

bootloader() { # add|remove
    [ "$DO_BOOT" -eq 1 ] || return 0
    mode=$1
    done_any=0
    # Fedora / RHEL (BLS entries): grubby is authoritative
    if command -v grubby >/dev/null 2>&1 && [ -d /boot/loader/entries ]; then
        args=$(grubby --info=ALL 2>/dev/null | grep '^args=' || true)
        if [ "$mode" = add ]; then
            missing=0
            for a in $(cmdline_args); do
                printf '%s\n' "$args" | grep -v -q -- "$a" && missing=1
            done
            if [ $missing -eq 1 ]; then
                grubby --update-kernel=ALL --args="$(cmdline_args)" >/dev/null 2>&1 && done_any=1
            fi
        elif printf '%s' "$args" | grep -q 'nvidia-drm\.'; then
            grubby --update-kernel=ALL --remove-args="nvidia-drm.modeset nvidia-drm.fbdev" >/dev/null 2>&1 && done_any=1
        fi
        # new kernels take their command line from /etc/default/grub (and /etc/kernel/cmdline)
        [ -f /etc/default/grub ] && edit_grub_default "$mode" && done_any=1
        [ $done_any -eq 1 ] && say "kernel command line updated (grubby)"
    elif [ -f /etc/default/grub ]; then
        if edit_grub_default "$mode"; then
            if command -v update-grub >/dev/null 2>&1; then
                update-grub >/dev/null 2>&1 || warn "update-grub failed"
            elif command -v grub-mkconfig >/dev/null 2>&1 && [ -d /boot/grub ]; then
                grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || warn "grub-mkconfig failed"
            elif command -v grub2-mkconfig >/dev/null 2>&1; then
                for c in /boot/grub2/grub.cfg /boot/efi/EFI/*/grub.cfg; do
                    [ -f "$c" ] && { grub2-mkconfig -o "$c" >/dev/null 2>&1 || warn "grub2-mkconfig failed"; break; }
                done
            fi
            say "kernel command line updated (GRUB)"
            done_any=1
        fi
    fi
    # systemd-boot / kernel-install / UKI
    if edit_plain /etc/kernel/cmdline "$mode"; then
        say "kernel command line updated (/etc/kernel/cmdline)"
        done_any=1
    fi
    if ! command -v grubby >/dev/null 2>&1; then
        for esp in /boot /efi /boot/efi; do
            for e in "$esp"/loader/entries/*.conf; do
                [ -f "$e" ] || continue
                line=$(grep -E '^options[[:space:]]' "$e" | head -n 1 || true)
                [ -n "$line" ] || continue
                val=${line#options}
                new=$(printf '%s' "$val" | sed -E 's/(^| )nvidia[-_]drm\.(modeset|fbdev)=[^ ]*//g; s/^ +//; s/ +$//')
                [ "$mode" = add ] && new="$new $(cmdline_args)"
                new=$(printf '%s' "$new" | sed 's/^ *//')
                if [ "$new" != "$(printf '%s' "$val" | sed 's/^ *//')" ]; then
                    esc=$(printf '%s' "$new" | sed 's/[&|\\]/\\&/g')
                    sed -i -E "s|^options[[:space:]].*|options ${esc}|" "$e"
                    say "updated $e"
                    done_any=1
                fi
            done
        done
    fi
    if [ $done_any -eq 0 ] && [ "$mode" = add ]; then
        say "no GRUB/systemd-boot configuration found; the modprobe.d option is used"
    fi
    [ $done_any -eq 1 ] && CHANGED=1
    return 0
}

if [ "$MODE" = remove ]; then
    if [ -f "$CONF" ] && grep -q "$MARK" "$CONF"; then
        rm -f "$CONF"; say "removed $CONF"; CHANGED=1
    fi
    bootloader remove
    [ $CHANGED -eq 1 ] && regen_initramfs && say "reboot required"
    exit 0
fi

# -------------------------------------------------------------------- apply
want="$MARK
# Kernel modesetting for the NVIDIA driver (required by Wayland compositors; off by
# default before driver 560). Undo: sudo aqua-nvidia-setup --remove
options $(params)"
suspend_units=0
if command -v systemctl >/dev/null 2>&1 && systemctl cat nvidia-suspend.service >/dev/null 2>&1; then
    suspend_units=1
    want="$want
# keep VRAM contents across suspend (nvidia-suspend/-resume/-hibernate services enabled)
options nvidia NVreg_PreserveVideoMemoryAllocations=1"
fi

if [ -f "$CONF" ] && ! grep -q "$MARK" "$CONF"; then
    warn "$CONF exists and was not written by Aqua — leaving it alone"
elif [ "$(cat "$CONF" 2>/dev/null || true)" != "$want" ]; then
    mkdir -p /etc/modprobe.d
    printf '%s\n' "$want" > "$CONF"
    chmod 644 "$CONF"
    say "wrote $CONF"
    CHANGED=1
fi
# a distribution file disabling it (e.g. "options nvidia-drm modeset=0") would win
for f in /etc/modprobe.d/*.conf; do
    [ "$f" = "$CONF" ] && continue
    if grep -qs -E '^[[:space:]]*options[[:space:]]+nvidia[-_]drm[[:space:]].*modeset=0' "$f"; then
        sed -i -E 's/^([[:space:]]*options[[:space:]]+nvidia[-_]drm[[:space:]].*)modeset=0/\1modeset=1/' "$f"
        say "switched modeset=0 to modeset=1 in $f"
        CHANGED=1
    fi
done
if [ $suspend_units -eq 1 ]; then
    for u in nvidia-suspend nvidia-resume nvidia-hibernate; do
        systemctl is-enabled "$u.service" >/dev/null 2>&1 || { systemctl enable "$u.service" >/dev/null 2>&1 && say "enabled $u.service"; } || true
    done
fi

bootloader add

if [ $CHANGED -eq 1 ]; then
    regen_initramfs
    case "$(active_modeset)" in
        Y|1) say "NVIDIA $VERSION: modesetting was already active; settings refreshed" ;;
        *) say "NVIDIA $VERSION: modesetting enabled — reboot required" ;;
    esac
else
    say "NVIDIA $VERSION: modesetting already configured (nvidia_drm.modeset=$(active_modeset))"
fi
exit 0
