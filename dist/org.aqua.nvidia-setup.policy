<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Aqua</vendor>
  <action id="org.aqua.nvidia-setup">
    <description>Enable NVIDIA kernel modesetting</description>
    <description xml:lang="ru">Включить kernel modesetting для NVIDIA</description>
    <message>Authentication is required to enable NVIDIA kernel modesetting (boot settings)</message>
    <message xml:lang="ru">Для включения NVIDIA kernel modesetting (параметры загрузки) требуется аутентификация</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@BINDIR@/aqua-nvidia-setup</annotate>
  </action>
</policyconfig>
