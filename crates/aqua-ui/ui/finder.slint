import { Theme, Glyphs, Field, PillButton, Checkbox, TrafficLights, PopupSelect, GlassSurround, Backdrop, SliderBar, GlassCapsule, NavArrows, GlassSel, AquaGlass, GlassShape } from "common.slint";
import { F, FItem, FPlace, FColumn, FMenuItem, FKV, FTagDef, FRow, FTab, FCrumb, FLCol, FOpt, FSpot, FCrit, FileIcon, FolderIcon, TagDots } from "finder-model.slint";
import { IconView, ListViewV, ColumnViewV, GalleryV } from "finder-views.slint";
import { MenuOverlay, FinderMenuWindow, AlertSheet, GotoPanel, ProgressCard, QuickLook, ViewOptions, PrefsPanel, RenamePanel, CustomizePanel } from "finder-panels.slint";
export { F, FItem, FPlace, FColumn, FMenuItem, FKV, FTagDef, FRow, FTab, FCrumb, FLCol, FOpt, FSpot, FCrit }
export { InfoWindow, FInfo } from "finder-info.slint";
export { FinderMenuWindow }

component ToolGlyph inherits Rectangle {
    in property <image> glyph;
    in property <bool> on;
    in property <bool> chevron;
    in property <bool> enabled: true;
    in property <length> w: 34px;
    callback clicked(length, length);
    callback right-clicked(length, length);
    width: w; height: 30px; border-radius: 15px;
    background: on ? (Theme.dark ? #ffffff2e : #0000001a) : ta.pressed && enabled ? Theme.control-pressed : (ta.has-hover && enabled ? Theme.hover : transparent);
    HorizontalLayout {
        alignment: center; spacing: 2px;
        VerticalLayout { alignment: center; Image { width: 19px; height: 19px; source: glyph; colorize: enabled ? Theme.text : Theme.text-tertiary; } }
        if chevron: VerticalLayout { alignment: center; Image { width: 9px; height: 9px; source: F.i-chev-down; colorize: Theme.text; } }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y + root.height + 6px); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.right-clicked(self.absolute-position.x, self.absolute-position.y + root.height + 6px);
            }
        }
    }
}

component Capsule inherits GlassCapsule { }

component Sidebar inherits Rectangle {
    callback want-focus();
    property <bool> solid: Theme.solid-sidebar;
    // Under Aqua the sidebar is the compositor's Liquid Glass (sidebar material).
    property <bool> lg: F.glass && AquaGlass.active;
    border-radius: solid ? 0px : 20px;
    GlassShape { width: parent.width; height: parent.height; material: 1; radius: parent.border-radius; on: F.glass; }
    background: lg ? transparent : solid
        ? (F.glass ? Theme.glass-side : (Theme.dark ? #29292c : #eeeff2))
        : (F.glass ? (Theme.dark ? #2c2c30c8 : #fbfcfec4) : @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.sidebar-bg2 100%));
    border-width: solid || lg ? 0px : 0.5px;
    border-color: F.glass ? (Theme.dark ? #ffffff26 : #ffffffb0) : Theme.sidebar-border;
    drop-shadow-blur: solid || lg ? 0px : 10px; drop-shadow-color: solid || lg ? transparent : #00000017; drop-shadow-offset-y: 2px;
    // Solid style: a hairline separates the sidebar from the content, with a faint highlight on its left.
    if solid: Rectangle { x: parent.width - 1px; width: 1px; background: Theme.dark ? #00000066 : #00000014; }
    if solid && Theme.dark: Rectangle { x: parent.width - 2px; width: 1px; background: #ffffff0a; }
    TouchArea {
        height: 44px;
        pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { F.win-drag(); } }
    }
    TrafficLights { x: solid ? 18px : 10px; y: solid ? 19px : 10px; active: F.active; close => { F.win-close(); } minimize => { F.win-minimize(); } zoom => { F.win-zoom(); } }
    Flickable {
        x: 0; y: solid ? 52px : 44px; width: parent.width; height: parent.height - (solid ? 58px : 50px);
        content-height: side.preferred-height + 8px;
        content-y <=> F.side-scroll;
        side := VerticalLayout {
            width: parent.width; padding-left: solid ? 10px : 9px; padding-right: solid ? 11px : 9px; spacing: 0px;
            for p in F.places: Rectangle {
                height: 32px;
                if p.path == "": Rectangle {
                    Text {
                        x: 8px; y: 0; height: 29px; text: p.header;
                        font-size: Theme.aqua ? 12px : 11px; font-weight: Theme.aqua ? 500 : 700; letter-spacing: 0.2px;
                        color: Theme.aqua ? Theme.side-header : (Theme.dark ? #ffffff80 : #00000096); vertical-alignment: TextVerticalAlignment.bottom;
                    }
                    if hta.has-hover: Image {
                        x: parent.width - 20px; y: 15px; width: 10px; height: 10px; source: F.i-chev-right;
                        colorize: Theme.text-secondary; transform-rotation: p.collapsed ? 0deg : 90deg;
                    }
                    hta := TouchArea { clicked => { F.section-toggle(p.section); } }
                }
                if p.path != "": Rectangle {
                    border-radius: 10px;
                    property <bool> sel: F.cur-place == p.path;
                    property <bool> drop: F.dragging && F.drop-place == p.path && F.drop-line < 0;
                    background: drop ? Theme.accent.with-alpha(0.3) : Theme.aqua ? transparent : sel ? (Theme.dark ? #ffffff24 : #00000012) : (ta.has-hover ? Theme.hover : transparent);
                    animate background { duration: 120ms; }
                    border-width: F.menu-open && F.ctx-place == p.path ? 2px : 0px;
                    border-color: Theme.accent;
                    if Theme.aqua && !(F.dragging && F.drop-place == p.path && F.drop-line < 0): GlassSel { sel: F.cur-place == p.path; hot: ta.has-hover; pressed: ta.pressed; }
                    if !p.is-tag: Image {
                        x: 9px; width: Theme.aqua ? 18px : 19px; height: self.width; source: Theme.aqua ? F.aqua-glyph(p.icon) : F.glyph(p.icon);
                        colorize: Theme.side-glyph;
                    }
                    if p.is-tag: Rectangle { x: 13px; width: 11px; height: 11px; border-radius: 5.5px; background: p.dot; }
                    Text {
                        x: 38px; width: parent.width - 38px - (p.eject ? 24px : 6px); text: p.label; font-size: 13px; letter-spacing: 0.2px;
                        font-weight: sel ? 500 : 400;
                        color: Theme.text; vertical-alignment: center; overflow: elide;
                    }
                    ta := TouchArea {
                        clicked => { F.place-click(p.path); root.want-focus(); }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                                F.place-context(p.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    if p.eject: Image {
                        x: parent.width - 22px; width: 13px; height: 13px; source: F.i-eject; colorize: Theme.text-secondary;
                        TouchArea { clicked => { F.menu-action("eject:" + p.path); } }
                    }
                }
            }
        }
        if F.drop-line >= 0: Rectangle {
            x: 14px; y: F.drop-line - 1px; width: parent.width - 28px; height: 2px; background: Theme.accent;
            Rectangle { x: -4px; y: -2px; width: 6px; height: 6px; border-radius: 3px; border-width: 1.5px; border-color: Theme.accent; background: Theme.window-bg; }
        }
    }
}

component PathBar inherits Rectangle {
    height: 28px;
    Rectangle { y: 0; height: 1px; background: Theme.separator; }
    Flickable {
        x: 12px; width: parent.width - 24px;
        content-width: max(self.width, crumbs.preferred-width);
        content-x: min(0px, self.width - crumbs.preferred-width);
        crumbs := HorizontalLayout {
            alignment: start; spacing: 2px;
            for c[i] in F.crumbs: HorizontalLayout {
                spacing: 2px;
                if i > 0: VerticalLayout { alignment: center; Image { width: 8px; height: 8px; source: F.i-chev-right; colorize: Theme.text-tertiary; } }
                Rectangle {
                    border-radius: 5px; width: cl.preferred-width + 10px;
                    background: cta.has-hover ? Theme.hover : transparent;
                    cl := HorizontalLayout {
                        x: 5px; spacing: 4px; alignment: start;
                        VerticalLayout {
                            alignment: center;
                            if c.icon == "folder": FolderIcon { s: 14px; }
                            if c.icon != "folder": Image { width: 14px; height: 14px; source: F.glyph(c.icon); colorize: Theme.text-secondary; }
                        }
                        Text { text: c.label; font-size: 11px; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                    cta := TouchArea {
                        double-clicked => { F.crumb-click(c.path); }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                                F.crumb-context(c.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                }
            }
        }
    }
}

component StatusBar inherits Rectangle {
    height: 26px;
    Rectangle { y: 0; height: 1px; background: Theme.separator; }
    Text {
        x: 100px; width: parent.width - 200px; height: parent.height;
        text: F.status + (F.free != "" ? ", " + F.free : ""); font-size: 11px; color: Theme.text-secondary;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    if F.view == 0 && root.width > 360px: SliderBar {
        x: parent.width - 112px; y: 2px; width: 96px;
        value: F.zoom;
        moved(v) => { F.set-zoom(v); }
        released(v) => { F.set-zoom(v); }
    }
}

component TabBar inherits Rectangle {
    // A capsule track with equal-width tabs; the current tab is a raised pill. “+” sits beside it.
    height: 38px;
    property <length> track-w: self.width - 20px - 38px;
    property <length> tw: (track-w - 4px) / max(1, F.tabs.length);
    // Aqua: the track is a glass capsule (rim lit from the top), the current tab a raised
    // glass pill inside it and “+” a round glass button — the toolbar's material.
    if Theme.aqua: GlassCapsule { x: 10px; y: 2px; width: track-w; height: 30px; }
    track := Rectangle {
        x: 10px; y: 2px; width: track-w; height: 30px; border-radius: 15px;
        background: Theme.aqua ? transparent : Theme.dark ? #ffffff0d : #0000000a;
        border-width: Theme.aqua ? 0px : 0.5px; border-color: Theme.dark ? #ffffff12 : #0000000a;
        for t[i] in F.tabs: Rectangle {
            property <length> dx: tta.dragging ? tta.mouse-x - tta.pressed-x : 0px;
            property <bool> out: tta.dragging && abs(tta.mouse-y - tta.pressed-y) > 36px;
            property <bool> cur: i == F.tab-idx;
            x: 2px + i * tw + dx; y: 2px; width: tw; height: parent.height - 4px;
            z: tta.dragging ? 1 : 0;
            opacity: out ? 0.6 : 1;
            border-radius: self.height / 2;
            background: Theme.aqua ? transparent : cur || tta.dragging ? (Theme.dark ? #ffffff24 : #ffffff) : (tta.has-hover ? Theme.hover : transparent);
            border-width: cur && !Theme.aqua ? 0.5px : 0px; border-color: Theme.dark ? #ffffff1f : #0000000f;
            drop-shadow-blur: (cur || tta.dragging) && !Theme.aqua ? 4px : 0px; drop-shadow-color: #00000024; drop-shadow-offset-y: 1px;
            animate background { duration: 120ms; }
            if Theme.aqua: GlassSel { border-radius: self.height / 2; sel: cur || tta.dragging; hot: tta.has-hover; }
            if i > 0 && !cur && i - 1 != F.tab-idx: Rectangle {
                x: -0.5px; y: (parent.height - 14px) / 2; width: 1px; height: 14px; background: Theme.dark ? #ffffff1f : #0000001a;
            }
            Text {
                x: 26px; width: parent.width - 52px; text: t.title; font-size: 12px;
                font-weight: cur ? 500 : 400;
                color: cur ? Theme.text : Theme.text-tertiary; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
            }
            tta := TouchArea {
                property <bool> dragging: self.pressed && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px);
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { F.tab-select(i); }
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.middle { F.tab-close(i); }
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                        F.tab-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                    if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.dragging {
                        if abs(self.mouse-y - self.pressed-y) > 36px {
                            F.tab-detach(i);
                        } else {
                            F.tab-move(i, max(0, min(F.tabs.length - 1, round((i * tw + self.mouse-x - self.pressed-x) / tw))));
                        }
                    }
                }
            }
            if F.tabs.length > 1: Rectangle {
                x: 6px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; border-radius: 8px;
                opacity: tta.has-hover || xta.has-hover ? 1 : 0;
                background: xta.has-hover ? Theme.control-pressed : transparent;
                Image { width: 8px; height: 8px; source: F.i-xmark; colorize: Theme.text-secondary; }
                xta := TouchArea { clicked => { F.tab-close(i); } }
            }
        }
    }
    if Theme.aqua: GlassCapsule {
        x: parent.width - 10px - 30px; y: 2px; width: 30px; height: 30px;
        hot: apta.has-hover;
        Rectangle { border-radius: 15px; background: apta.pressed ? Theme.control-pressed : transparent; }
        Image { width: 14px; height: 14px; source: F.i-plus; colorize: Theme.text; }
        apta := TouchArea { clicked => { F.tab-new(); } }
    }
    if !Theme.aqua: Rectangle {
        x: parent.width - 10px - 30px; y: 2px; width: 30px; height: 30px; border-radius: 15px;
        background: pta.pressed ? Theme.control-pressed : (pta.has-hover ? (Theme.dark ? #ffffff24 : #0000000f) : (Theme.dark ? #ffffff17 : #ffffffd9));
        border-width: 0.5px; border-color: Theme.dark ? #ffffff1f : #0000000f;
        Image { width: 13px; height: 13px; source: F.i-plus; colorize: Theme.text; }
        pta := TouchArea { clicked => { F.tab-new(); } }
    }
}

// Small rounded-rect bezel button of the search bar (Save, −, +).
component BarButton inherits Rectangle {
    in property <string> text;
    in property <image> glyph;
    in property <bool> has-glyph;
    callback clicked();
    height: 24px; border-radius: 7px;
    width: has-glyph ? 40px : max(56px, bt.preferred-width + 24px);
    background: rta.pressed ? Theme.control-pressed : (rta.has-hover ? (Theme.dark ? #ffffff2b : #00000014) : Theme.control-bg);
    border-width: 0.5px; border-color: Theme.control-border;
    animate background { duration: 100ms; }
    bt := Text { visible: !has-glyph; text: root.text; font-size: 13px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
    if has-glyph: Image { width: 11px; height: 11px; source: root.glyph; colorize: Theme.text; }
    rta := TouchArea { clicked => { root.clicked(); } }
}

component ScopeBar inherits Rectangle {
    height: 40px + F.crit.length * 36px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
    HorizontalLayout {
        height: 36px; y: 2px;
        padding-left: 14px; padding-right: 12px; spacing: 6px;
        VerticalLayout { alignment: center; Text { text: @tr("Search:"); font-size: 13px; font-weight: 700; color: Theme.text-secondary; } }
        Rectangle { width: 2px; }
        for s[i] in [@tr("This Computer"), F.scope-folder]: VerticalLayout {
            alignment: center;
            if s != "": Rectangle {
                property <bool> on: F.search-scope == i;
                height: 24px; width: st.preferred-width + 22px; border-radius: 7px;
                background: on ? (Theme.dark ? #ffffff29 : #0000001a) : (sta.has-hover ? Theme.hover : transparent);
                animate background { duration: 120ms; }
                st := Text {
                    text: i == 1 ? "“" + s + "”" : s; font-size: 13px; font-weight: 700;
                    color: on ? Theme.text : Theme.text-secondary;
                }
                sta := TouchArea { clicked => { F.set-scope(i); } }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout { alignment: center; BarButton { text: @tr("Save"); clicked => { F.save-search(); } } }
        if F.crit.length == 0: VerticalLayout { alignment: center; BarButton { has-glyph: true; glyph: F.i-plus; clicked => { F.crit-add(-1); } } }
        if F.crit.length > 0: VerticalLayout { alignment: center; BarButton { has-glyph: true; glyph: F.i-minus; clicked => { F.menu-action("crit-clear"); } } }
    }
    for c[i] in F.crit: HorizontalLayout {
        y: 38px + i * 36px; height: 36px;
        padding-left: 12px; padding-right: 12px; spacing: 8px;
        VerticalLayout { alignment: center; PopupSelect { width: c.attr == 0 ? 96px : 170px; bezel: true; items: F.crit-attrs; current: c.attr; changed(v) => { F.crit-set(i, "attr", v); } } }
        if c.attr == 0: VerticalLayout { alignment: center; Text { text: @tr("is"); font-size: 13px; color: Theme.text-secondary; } }
        if c.ops.length > 0: VerticalLayout { alignment: center; PopupSelect { width: 156px; bezel: true; items: c.ops; current: c.op; changed(v) => { F.crit-set(i, "op", v); } } }
        if c.has-value: VerticalLayout {
            alignment: center;
            Field { width: c.units.length > 0 ? 70px : 200px; height: 24px; font-size: 13px; text: c.value; edited(t) => { F.crit-value(i, t); } }
        }
        if c.units.length > 0: VerticalLayout { alignment: center; PopupSelect { width: 96px; bezel: true; items: c.units; current: c.unit; changed(v) => { F.crit-set(i, "unit", v); } } }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout { alignment: center; BarButton { has-glyph: true; glyph: F.i-minus; clicked => { F.crit-remove(i); } } }
        VerticalLayout { alignment: center; BarButton { has-glyph: true; glyph: F.i-plus; clicked => { F.crit-add(i); } } }
    }
}

// Suggestions under the search field while typing (Filenames / Content / Kinds).
component SearchSuggestions inherits Rectangle {
    property <string> q: F.query;
    border-radius: 12px;
    background: Theme.dark ? #2e2e31f5 : #f6f6f8f7;
    border-width: 0.5px; border-color: Theme.dark ? #ffffff2e : #0000001f;
    drop-shadow-blur: 22px; drop-shadow-color: Theme.dark ? #00000080 : #00000030; drop-shadow-offset-y: 8px;
    height: lay.preferred-height;
    TouchArea {}
    lay := VerticalLayout {
        padding: 6px; padding-top: 4px; spacing: 0px;
        for g[gi] in [
            { title: @tr("Filenames"), label: @tr("Name Contains “{}”", q), id: "search-pick:0" },
            { title: @tr("Content"), label: @tr("Contains “{}”", q), id: "search-pick:1" },
        ]: VerticalLayout {
            if gi > 0: Rectangle { height: 9px; Rectangle { x: 12px; width: parent.width - 24px; height: 1px; background: Theme.separator; } }
            Rectangle {
                height: 22px;
                Text { x: 12px; text: g.title; font-size: 12px; font-weight: 700; color: Theme.text-tertiary; vertical-alignment: center; }
            }
            Rectangle {
                height: 24px; border-radius: 6px;
                background: gta.has-hover ? Theme.accent : transparent;
                Text { x: 12px; width: parent.width - 20px; text: g.label; font-size: 13px; color: gta.has-hover ? white : Theme.text; vertical-alignment: center; overflow: elide; }
                gta := TouchArea { clicked => { F.sugg-hide = true; F.menu-action(g.id); } }
            }
        }
        if F.sugg-kinds.length > 0: VerticalLayout {
            Rectangle { height: 9px; Rectangle { x: 12px; width: parent.width - 24px; height: 1px; background: Theme.separator; } }
            Rectangle {
                height: 22px;
                Text { x: 12px; text: @tr("Kinds"); font-size: 12px; font-weight: 700; color: Theme.text-tertiary; vertical-alignment: center; }
            }
            for k in F.sugg-kinds: Rectangle {
                height: 24px; border-radius: 6px;
                background: kta.has-hover ? Theme.accent : transparent;
                Text { x: 12px; width: parent.width - 20px; text: k.label; font-size: 13px; color: kta.has-hover ? white : Theme.text; vertical-alignment: center; overflow: elide; }
                kta := TouchArea { clicked => { F.sugg-hide = true; F.menu-action("search-pick:" + k.id); } }
            }
        }
    }
}

// “Loading…” pill with a spinner shown while a search is running.
component LoadingPill inherits Rectangle {
    width: lt.preferred-width + 46px; height: 30px; border-radius: 9px;
    background: Theme.dark ? #3a3a3ce6 : #ffffffeb;
    border-width: 0.5px; border-color: Theme.dark ? #ffffff1a : #0000001a;
    drop-shadow-blur: 12px; drop-shadow-color: #00000033; drop-shadow-offset-y: 3px;
    property <int> phase: mod(floor(animation-tick() / 90ms), 8);
    for d in 8: Rectangle {
        property <angle> a: d * 45deg;
        x: 18px + 6px * cos(a) - 1.25px; y: 15px + 6px * sin(a) - 1.25px;
        width: 2.5px; height: 2.5px; border-radius: 1.25px;
        background: Theme.text-secondary;
        opacity: 0.2 + 0.8 * mod(d - phase + 8, 8) / 7;
    }
    lt := Text { x: 32px; text: @tr("Loading…"); font-size: 13px; color: Theme.text-secondary; vertical-alignment: center; }
}

component SaveSearchPanel inherits Rectangle {
    background: #00000030;
    TouchArea {}
    Rectangle {
        x: (parent.width - 340px) / 2; y: 70px; width: 340px; height: lay.preferred-height;
        border-radius: 22px; background: Theme.menu-bg;
        border-width: 0.5px; border-color: Theme.dark ? #ffffff26 : #0000001f;
        drop-shadow-blur: 30px; drop-shadow-color: #00000055; drop-shadow-offset-y: 10px;
        lay := VerticalLayout {
            padding: 18px; spacing: 10px;
            Text { text: @tr("Save As:"); font-size: 13px; font-weight: 700; color: Theme.text; }
            Field { text <=> F.ss-name; accepted => { F.save-search-done(); } init => { self.focus(); } }
            HorizontalLayout {
                spacing: 6px; alignment: start;
                VerticalLayout { alignment: center; Checkbox { checked <=> F.ss-side; } }
                Text { text: @tr("Add To Sidebar"); font-size: 13px; color: Theme.text; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 8px; alignment: end;
                PillButton { text: @tr("Cancel"); min-w: 80px; clicked => { F.ss-open = false; } }
                PillButton { text: @tr("Save"); primary: true; min-w: 80px; enabled: F.ss-name != ""; clicked => { F.save-search-done(); } }
            }
        }
    }
}

component ToolbarPanel inherits Rectangle {
    background: #00000030;
    TouchArea {}
    pure function icon(id: string) -> image {
        if id == "back" { return F.i-back; }
        if id == "view" { return F.i-icons; }
        if id == "group" { return F.i-group; }
        if id == "action" { return F.i-more; }
        if id == "share" { return F.i-share; }
        if id == "tags" { return F.i-tag; }
        if id == "newfolder" { return @image-url("icons/m-folder-plus.svg"); }
        if id == "delete" { return @image-url("icons/f-trash.svg"); }
        if id == "info" { return F.i-info; }
        if id == "ql" { return @image-url("icons/m-eye.svg"); }
        if id == "connect" { return @image-url("icons/f-network.svg"); }
        if id == "eject" { return F.i-eject; }
        return F.i-search;
    }
    Rectangle {
        x: (parent.width - self.width) / 2; y: 60px; width: 4 * 104px + 36px; height: lay.preferred-height;
        border-radius: 22px; background: Theme.menu-bg;
        border-width: 0.5px; border-color: Theme.dark ? #ffffff26 : #0000001f;
        drop-shadow-blur: 30px; drop-shadow-color: #00000055; drop-shadow-offset-y: 10px;
        lay := VerticalLayout {
            padding: 18px; spacing: 12px;
            Text { text: @tr("Choose the items shown in the toolbar."); font-size: 13px; font-weight: 700; color: Theme.text; }
            Rectangle {
                height: ceil(F.tb-opts.length / 4) * 78px;
                for o[i] in F.tb-opts: Rectangle {
                    x: mod(i, 4) * 104px; y: floor(i / 4) * 78px; width: 98px; height: 72px; border-radius: 12px;
                    background: o.on ? Theme.accent.with-alpha(0.16) : (ota.has-hover ? Theme.hover : transparent);
                    border-width: o.on ? 1px : 0px; border-color: Theme.accent.with-alpha(0.6);
                    Rectangle {
                        y: 8px; width: 40px; height: 32px; border-radius: 16px;
                        background: Theme.dark ? #ffffff17 : #ffffffd9;
                        border-width: 0.5px; border-color: Theme.dark ? #ffffff1f : #0000001a;
                        Image { width: 18px; height: 18px; source: icon(o.id); colorize: Theme.text; }
                    }
                    Text { y: 46px; width: parent.width - 8px; x: 4px; text: o.label; font-size: 11px; color: Theme.text; horizontal-alignment: center; overflow: elide; }
                    ota := TouchArea { clicked => { F.tb-toggle(o.id); } }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                PillButton { text: @tr("Restore Default"); clicked => { F.tb-reset(); } }
                Rectangle { horizontal-stretch: 1; }
                PillButton { text: @tr("Done"); primary: true; min-w: 80px; clicked => { F.tb-open = false; } }
            }
        }
    }
}

component ConnectPanel inherits Rectangle {
    background: #00000030;
    TouchArea {}
    Rectangle {
        x: (parent.width - self.width) / 2; y: 60px; width: 460px; height: lay.preferred-height;
        border-radius: 22px; background: Theme.menu-bg;
        border-width: 0.5px; border-color: Theme.dark ? #ffffff26 : #0000001f;
        drop-shadow-blur: 30px; drop-shadow-color: #00000055; drop-shadow-offset-y: 10px;
        lay := VerticalLayout {
            padding: 18px; spacing: 10px;
            Text { text: @tr("Connect to Server"); font-size: 13px; font-weight: 700; color: Theme.text; }
            HorizontalLayout {
                spacing: 8px;
                Field {
                    horizontal-stretch: 1; text <=> F.cs-addr; placeholder: @tr("smb://server/share, sftp://host, ftp://…");
                    accepted(t) => { F.cs-connect(t); }
                    init => { self.focus(); }
                }
                if F.cs-recent.length > 0: PopupSelect {
                    width: 34px; bezel: true; items: F.cs-recent; current: -1;
                    changed(i) => { F.cs-addr = F.cs-recent[i]; }
                }
            }
            Text { text: @tr("Favorite Servers:"); font-size: 12px; color: Theme.text-secondary; }
            Rectangle {
                height: 120px; border-radius: 8px; background: Theme.field-bg; clip: true;
                border-width: 0.5px; border-color: Theme.control-border;
                Flickable {
                    content-height: F.cs-favs.length * 24px + 8px;
                    for a[i] in F.cs-favs: Rectangle {
                        x: 4px; y: 4px + i * 24px; width: parent.width - 8px; height: 24px; border-radius: 6px;
                        background: F.cs-sel == i ? Theme.accent : transparent;
                        Image { x: 8px; y: 4px; width: 16px; height: 16px; source: @image-url("icons/f-network.svg"); colorize: F.cs-sel == i ? white : Theme.accent; }
                        Text { x: 32px; width: parent.width - 40px; text: a; font-size: 13px; color: F.cs-sel == i ? white : Theme.text; vertical-alignment: center; overflow: elide; }
                        TouchArea {
                            clicked => { F.cs-sel = i; F.cs-addr = a; }
                            double-clicked => { F.cs-connect(a); }
                        }
                    }
                }
                if F.cs-favs.length == 0: Text {
                    text: @tr("No favorite servers"); font-size: 12px; color: Theme.text-tertiary;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                PillButton { text: "+"; min-w: 32px; enabled: F.cs-addr != ""; clicked => { F.cs-add(F.cs-addr); } }
                PillButton { text: "−"; min-w: 32px; enabled: F.cs-sel >= 0; clicked => { F.cs-remove(F.cs-sel); } }
                Rectangle { horizontal-stretch: 1; }
                if F.cs-busy: Text { text: @tr("Connecting…"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
                PillButton { text: @tr("Cancel"); min-w: 80px; clicked => { F.cs-open = false; } }
                PillButton { text: @tr("Connect"); primary: true; min-w: 80px; enabled: F.cs-addr != "" && !F.cs-busy; clicked => { F.cs-connect(F.cs-addr); } }
            }
        }
    }
}

export component FinderWindow inherits Window {
    in property <string> title-override;
    title: title-override != "" ? title-override : F.title;
    no-frame: true;
    preferred-width: 1000px; preferred-height: 600px;
    min-width: 620px; min-height: 380px;
    background: transparent;
    default-font-family: Theme.font;
    forward-focus: keys;
    in property <int> repaint;
    property <bool> side-on: F.show-sidebar || F.mode != 0;
    property <length> side-w: side-on ? F.side-w : 0px;
    property <bool> solid-side: Theme.solid-sidebar;
    property <length> cx: side-on ? side-w + 8px : 0px;
    property <length> pv-w: F.show-preview && F.mode == 0 && root.width > 820px ? 268px : 0px;
    // Like macOS: no tab bar for a single tab (it appears with the second one).
    property <length> tab-h: F.show-tabbar && F.mode == 0 && F.tabs.length > 1 ? 38px : 0px;
    property <length> scope-h: F.in-search ? 40px + F.crit.length * 36px : 0px;
    property <length> top-h: 52px + tab-h + scope-h + (F.mode == 2 ? 78px : 0px);
    property <length> path-h: F.show-pathbar && F.mode == 0 ? 28px : 0px;
    property <length> stat-h: F.show-statusbar && F.mode == 0 ? 26px : 0px;
    property <length> bot-h: F.mode != 0 ? 52px : path-h + stat-h;
    property <length> cw: root.width - cx - pv-w;
    property <length> ch: root.height - top-h - bot-h;
    property <length> search-w: root.width > 980px ? 300px : 230px;
    property <string> geo: F.view + ":" + cx / 1px + ":" + top-h / 1px + ":" + cw / 1px + ":" + ch / 1px + ":" + F.items.length + ":" + F.icon-s / 1px;
    changed geo => { F.relayout(F.view, cx, top-h, cw, ch); }
    init => { F.relayout(F.view, cx, top-h, cw, ch); }
    Rectangle { background: mod(repaint, 2) == 0 ? #00000000 : #00000001; }

    if !F.glass: Rectangle { background: Theme.window-bg; }
    if F.glass: GlassSurround {
        width: root.width; height: root.height; color: Theme.glass-bg;
        hole-x: solid-side ? 0px : 8px; hole-y: solid-side ? 0px : 8px;
        hole-w: side-on ? (solid-side ? cx : side-w) : 0px; hole-h: solid-side ? root.height : root.height - 16px;
        hole-r: solid-side ? 0px : 20px;
    }

    keys := FocusScope {
        key-pressed(e) => {
            if F.renaming >= 0 { return reject; }
            if e.text == Key.Escape && (F.menu-open || F.tags-open || F.custom-open || F.goto-open || F.vo-open || F.prefs-open || F.rn-open || F.ss-open || F.tb-open || F.cs-open) {
                F.menu-open = false; F.sub-open = false; F.tags-open = false; F.custom-open = false; F.goto-open = false;
                F.vo-open = false; F.prefs-open = false; F.rn-open = false; F.ss-open = false; F.tb-open = false; F.cs-open = false;
                return accept;
            }
            if F.key(e.text, e.modifiers.control, e.modifiers.meta, e.modifiers.shift, e.modifiers.alt, 0) { return accept; }
            reject
        }
    }

    content := Rectangle {
        x: cx; y: top-h; width: cw; height: ch;
        clip: true;
        if F.view == 0: IconView { want-focus => { keys.focus(); } }
        if F.view == 1: ListViewV { want-focus => { keys.focus(); } }
        if F.view == 2: ColumnViewV { want-focus => { keys.focus(); } }
        if F.view == 3: GalleryV { want-focus => { keys.focus(); } }
        if F.items.length == 0 && F.view != 2: Text {
            y: F.view == 3 ? 0 : 0; height: F.view == 3 ? parent.height - 90px : parent.height;
            text: F.empty-text; font-size: 13px; color: Theme.text-tertiary;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    if F.mq-on && F.mq-w > 0 && F.mq-h > 0: Rectangle {
        x: F.mq-x; y: F.mq-y; width: F.mq-w; height: F.mq-h;
        background: Theme.accent.with-alpha(0.15); border-width: 1px; border-color: Theme.accent.with-alpha(0.7);
    }

    if F.mode == 2: Rectangle {
        x: cx; y: 52px; width: cw + pv-w; height: 78px;
        GridLayout {
            x: 0; width: min(parent.width, 460px); padding-left: 24px; spacing: 8px; padding-top: 8px;
            Row {
                Text { text: @tr("Save As:"); font-size: 13px; color: Theme.text; vertical-alignment: center; horizontal-alignment: right; }
                Field { text <=> F.save-name; placeholder: @tr("Untitled"); edited(t) => { F.save-edited(t); } accepted => { F.accept(); } }
            }
            Row {
                Text { text: @tr("Tags:"); font-size: 13px; color: Theme.text; vertical-alignment: center; horizontal-alignment: right; }
                Rectangle {
                    height: 28px; border-radius: 7px; background: Theme.field-bg;
                    HorizontalLayout {
                        padding-left: 8px; spacing: 6px; alignment: start;
                        for t in F.tag-defs: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 14px; height: 14px; border-radius: 7px; background: t.color;
                                border-width: t.on ? 2px : 0px; border-color: Theme.text;
                                TouchArea { clicked => { F.tag-toggle(t.name); } }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
    }

    if tab-h > 0: TabBar { x: cx; y: 52px; width: root.width - cx; }
    if scope-h > 0: ScopeBar { x: cx; y: 52px + tab-h; width: root.width - cx; }

    if pv-w > 0: Rectangle {
        x: root.width - pv-w; y: top-h; width: pv-w; height: root.height - top-h - bot-h;
        Rectangle { x: 0; width: 1px; background: Theme.separator; }
        if !F.pv-any: Text {
            text: F.pv-count > 1 ? @tr("{} items selected", F.pv-count) : @tr("No Selection"); font-size: 13px; color: Theme.text-tertiary;
            horizontal-alignment: center; vertical-alignment: center;
        }
        // Clip explicitly: a Flickable does not clip its content, so the information rows
        // used to slide under the quick-action bar ("More…") in short windows.
        if F.pv-any: Rectangle {
          x: 1px; y: 0; width: parent.width - 1px; height: max(0px, parent.height - 64px); clip: true;
          Flickable {
            width: parent.width; height: parent.height;
            content-height: pvl.preferred-height;
            pvl := VerticalLayout {
                width: parent.width;
                padding: 12px; padding-top: 4px; spacing: 6px;
                Rectangle {
                    height: F.pv.snippet != "" && !F.pv.has-thumb ? 228px : 220px;
                    border-radius: 10px;
                    background: F.pv.snippet != "" && !F.pv.has-thumb ? (Theme.dark ? #2a2a2c : white) : transparent;
                    border-width: F.pv.snippet != "" && !F.pv.has-thumb ? 0.5px : 0px; border-color: Theme.separator;
                    clip: true;
                    if F.pv.snippet != "" && !F.pv.has-thumb: Text {
                        x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 12px;
                        text: F.pv.snippet; font-size: 10.5px; font-family: "DejaVu Sans Mono"; color: Theme.text; wrap: word-wrap; overflow: TextOverflow.clip;
                    }
                    if F.pv.snippet == "" || F.pv.has-thumb: FileIcon { item: F.pv; s: min(parent.width - 16px, 200px); }
                }
                Rectangle { height: 6px; }
                Text { text: F.pv.name; font-size: 15px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                Text { text: F.pv.kind-label + (F.pv.size != "" && F.pv.size != "--" ? " – " + F.pv.size : ""); font-size: 12px; color: Theme.text-secondary; }
                if F.pv.tags.length > 0: HorizontalLayout { alignment: start; TagDots { tags: F.pv.tags; } }
                Rectangle { height: 8px; }
                Text { text: @tr("Information"); font-size: 13px; font-weight: 700; color: Theme.text; }
                for kv[i] in F.pv-info: VerticalLayout {
                    if F.pv-more || i < 3: Rectangle {
                        height: 26px;
                        Text { x: 0; width: 110px; text: kv.k; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                        Text { x: 110px; width: parent.width - 110px; text: kv.v; font-size: 12px; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
                    }
                }
            }
        }
        }
        if F.pv-any: Rectangle {
            y: parent.height - 64px; height: 64px;
            Rectangle { y: 0; height: 1px; x: 1px; background: Theme.separator; }
            HorizontalLayout {
                alignment: center; spacing: 14px;
                for b[i] in F.pv-quick ? [
                    { id: "quick:rotl", label: @tr("Rotate Left"), icon: @image-url("icons/f-rotate-left.svg") },
                    { id: "quick:pdf", label: @tr("Create PDF"), icon: @image-url("icons/f-pdf.svg") },
                    { id: "more", label: F.pv-more ? @tr("Less") : @tr("More..."), icon: F.i-more },
                ] : [{ id: "more", label: F.pv-more ? @tr("Less") : @tr("More..."), icon: F.i-more }]: VerticalLayout {
                    alignment: center; spacing: 3px; width: 64px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px; height: 26px; border-radius: 13px; background: qta.has-hover ? Theme.hover : transparent;
                            border-width: 1px; border-color: Theme.text-secondary;
                            Image { width: 13px; height: 13px; source: b.icon; colorize: Theme.text-secondary; }
                            qta := TouchArea { clicked => { if b.id == "more" { F.pv-more = !F.pv-more; } else { F.menu-action(b.id); } } }
                        }
                    }
                    Text { text: b.label; font-size: 11px; color: Theme.text-secondary; horizontal-alignment: center; overflow: elide; }
                }
            }
        }
    }

    toolbar := Rectangle {
        x: cx; y: 0; width: root.width - self.x; height: 52px;
        property <length> lead: side-on ? 0px : 86px;
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { F.win-drag(); }
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    F.toolbar-menu("toolbar", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        if !side-on: TrafficLights { x: 18px; y: 19px; active: F.active; close => { F.win-close(); } minimize => { F.win-minimize(); } zoom => { F.win-zoom(); } }
        if F.tb-back: NavArrows {
            x: 7px + lead; y: 8px;
            can-back: F.can-back; can-forward: F.can-forward;
            back => { F.back(); }
            forward => { F.forward(); }
            history-menu(b, x, y) => { F.toolbar-menu(b ? "history-back" : "history-forward", x, y); }
        }
        title-text := Text {
            x: (F.tb-back ? 93px : 14px) + lead; height: 52px; width: min(self.preferred-width, max(40px, tools.x - 100px - lead));
            vertical-alignment: center; font-size: 15px; font-weight: 700; color: Theme.text; text: F.title; overflow: elide;
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                        F.toolbar-menu("path", self.absolute-position.x + 120px, self.absolute-position.y + 40px);
                    }
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { F.win-drag(); }
                }
            }
        }
        property <bool> wide: root.width > 900px;
        // Room for the four view buttons next to the title (otherwise one view pop-up button).
        property <bool> roomy: root.width - cx > (F.searching ? 940px : 800px);
        tools := HorizontalLayout {
            x: parent.width - self.preferred-width - 9px; y: 8px; height: 36px; spacing: 14px;
            if F.tb-view && !roomy: Capsule {
                width: 56px;
                ToolGlyph {
                    x: 3px; y: 3px; w: 50px; chevron: true;
                    glyph: F.view == 0 ? F.i-icons : F.view == 1 ? F.i-list : F.view == 2 ? F.i-columns : F.i-gallery;
                    clicked(x, y) => { F.toolbar-menu("view", x, y); }
                }
            }
            if F.tb-view && roomy: Capsule {
                width: vh.preferred-width + 8px;
                vh := HorizontalLayout {
                    x: 4px; padding-top: 3px; padding-bottom: 3px; spacing: 0px;
                    ToolGlyph { w: 35px; glyph: F.i-icons; on: F.view == 0; clicked => { F.set-view(0); } }
                    ToolGlyph { w: 35px; glyph: F.i-list; on: F.view == 1; clicked => { F.set-view(1); } }
                    ToolGlyph { w: 35px; glyph: F.i-columns; on: F.view == 2; clicked => { F.set-view(2); } }
                    ToolGlyph { w: 35px; glyph: F.i-gallery; on: F.view == 3; clicked => { F.set-view(3); } }
                }
            }
            if wide && F.tb-group: Capsule {
                width: 49px;
                ToolGlyph { x: 2px; y: 3px; w: 45px; glyph: F.i-group; chevron: true; on: F.group-by != 0; clicked(x, y) => { F.toolbar-menu("group", x, y); } }
            }
            if F.mode == 0 && (F.tb-newfolder || F.tb-delete || F.tb-info || F.tb-ql || F.tb-connect || F.tb-eject): Capsule {
                width: xh.preferred-width + 8px;
                xh := HorizontalLayout {
                    x: 4px; padding-top: 3px; padding-bottom: 3px; spacing: 0px;
                    if F.tb-newfolder: ToolGlyph { w: 36.6px; glyph: @image-url("icons/m-folder-plus.svg"); clicked => { F.menu-action("new-folder"); } }
                    if F.tb-delete: ToolGlyph { w: 36.6px; glyph: @image-url("icons/f-trash.svg"); enabled: F.pv-any || F.pv-count > 0; clicked => { F.menu-action("trash"); } }
                    if F.tb-info: ToolGlyph { w: 36.6px; glyph: F.i-info; clicked => { F.menu-action("info-window"); } }
                    if F.tb-ql: ToolGlyph { w: 36.6px; glyph: @image-url("icons/m-eye.svg"); enabled: F.pv-any || F.pv-count > 0; clicked => { F.menu-action("quicklook"); } }
                    if F.tb-connect: ToolGlyph { w: 36.6px; glyph: @image-url("icons/f-network.svg"); clicked => { F.menu-action("connect"); } }
                    if F.tb-eject: ToolGlyph { w: 36.6px; glyph: F.i-eject; clicked => { F.menu-action("eject"); } }
                }
            }
            if F.mode == 0 && (F.tb-share || F.tb-tags || F.tb-action): Capsule {
                width: th.preferred-width + 8px;
                th := HorizontalLayout {
                    x: 4px; padding-top: 3px; padding-bottom: 3px; spacing: 0px;
                    if F.tb-share: ToolGlyph { w: 36.6px; glyph: F.i-share; clicked(x, y) => { F.toolbar-menu("share", x, y); } }
                    if F.tb-tags: ToolGlyph { w: 36.6px; glyph: F.i-tag; on: F.tags-open; clicked(x, y) => { F.toolbar-menu("tags", x, y); } }
                    if F.tb-action: ToolGlyph { w: 36.6px; glyph: F.i-more; clicked(x, y) => { F.toolbar-menu("more", x, y); } }
                }
            }
            if !F.searching && (F.tb-search || F.mode != 0): Capsule {
                width: 36px;
                ToolGlyph { x: 1px; y: 3px; w: 34px; glyph: F.i-search; clicked => { F.searching = true; } }
            }
            if F.searching: Capsule {
                width: root.search-w;
                border-width: sf.has-focus ? 3px : 0.5px;
                border-color: sf.has-focus ? Theme.accent.with-alpha(0.55) : (Theme.dark ? #ffffff1f : #0000000f);
                Image { x: 12px; width: 14px; height: 14px; source: F.i-search; colorize: Theme.text-secondary; }
                sf := TextInput {
                    x: 34px; width: parent.width - 62px; height: 100%; text <=> F.query; font-size: 13px; color: Theme.text;
                    vertical-alignment: center; single-line: true;
                    edited => { F.sugg-hide = false; F.search-focus = true; F.search(self.text); }
                    accepted => { F.sugg-hide = true; F.menu-action("search-pick:0"); }
                    changed has-focus => { F.search-focus = self.has-focus; }
                    key-pressed(e) => {
                        if e.text == Key.Escape && !F.sugg-hide && F.query != "" { F.sugg-hide = true; return accept; }
                        if e.text == Key.Escape { F.searching = false; F.query = ""; F.search(""); keys.focus(); return accept; }
                        if e.text == Key.DownArrow { keys.focus(); return accept; }
                        reject
                    }
                    init => { self.focus(); F.search-focus = true; }
                }
                if F.query == "": Text { x: 34px; height: 100%; text: @tr("Search"); font-size: 13px; color: Theme.text-tertiary; vertical-alignment: center; }
                if F.query != "": Rectangle {
                    x: parent.width - 26px; width: 18px; height: 18px; border-radius: 9px; background: Theme.text-tertiary;
                    Image { width: 9px; height: 9px; source: F.i-xmark; colorize: Theme.window-bg; }
                    TouchArea { clicked => { F.searching = false; F.query = ""; F.search(""); keys.focus(); } }
                }
                init => { F.sugg-hide = true; }
            }
        }
    }

    if path-h > 0: PathBar { x: cx; y: root.height - bot-h; width: root.width - cx; }
    if stat-h > 0: StatusBar { x: cx; y: root.height - stat-h; width: root.width - cx; }

    if F.mode != 0: Rectangle {
        x: cx; y: root.height - 52px; width: root.width - cx; height: 52px;
        Rectangle { y: 0; height: 1px; background: Theme.separator; }
        HorizontalLayout {
            padding-left: 16px; padding-right: 16px; spacing: 10px; alignment: stretch;
            if F.mode == 2 || F.directory-mode: VerticalLayout { alignment: center; PillButton { text: @tr("New Folder"); clicked => { F.menu-action("new-folder"); } } }
            Rectangle { horizontal-stretch: 1; }
            if F.filters.length > 0: VerticalLayout {
                alignment: center; width: 170px;
                PopupSelect { bezel: true; items: F.filters; current <=> F.filter-idx; changed(i) => { F.filter-changed(i); } }
            }
            VerticalLayout { alignment: center; PillButton { text: @tr("Cancel"); min-w: 76px; clicked => { F.cancel(); } } }
            VerticalLayout { alignment: center; PillButton { text: F.accept-label; primary: true; min-w: 76px; enabled: F.can-accept; clicked => { F.accept(); } } }
        }
    }

    if side-on: Sidebar {
        x: solid-side ? 0px : 8px; y: solid-side ? 0px : 8px;
        width: solid-side ? cx : side-w; height: solid-side ? root.height : root.height - 16px;
        want-focus => { keys.focus(); }
    }
    if side-on && F.mode == 0: TouchArea {
        x: 8px + side-w - 2px; y: 52px; width: 8px; height: root.height - 60px;
        mouse-cursor: MouseCursor.col-resize;
        property <length> start;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { self.start = F.side-w; }
            if e.kind == PointerEventKind.up { F.side-resized(F.side-w); }
        }
        moved => {
            if self.pressed { F.side-w = max(140px, min(360px, self.start + self.mouse-x - self.pressed-x)); }
        }
    }

    for e[i] in [
        { x: 10px, y: 0px, w: root.width - 20px, h: 4px, c: MouseCursor.ns-resize },
        { x: 10px, y: root.height - 4px, w: root.width - 20px, h: 4px, c: MouseCursor.ns-resize },
        { x: 0px, y: 10px, w: 4px, h: root.height - 20px, c: MouseCursor.ew-resize },
        { x: root.width - 4px, y: 10px, w: 4px, h: root.height - 20px, c: MouseCursor.ew-resize },
        { x: 0px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
        { x: root.width - 10px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
        { x: 0px, y: root.height - 10px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
        { x: root.width - 10px, y: root.height - 10px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
    ]: TouchArea {
        x: e.x; y: e.y; width: e.w; height: e.h; mouse-cursor: e.c;
        pointer-event(ev) => { if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left { F.win-resize(i); } }
    }

    if F.dragging: Rectangle {
        x: F.drag-x - 30px; y: F.drag-y - 30px; width: 60px; height: 60px;
        opacity: 0.85;
        Rectangle { width: 48px; height: 48px; border-radius: 10px; background: Theme.accent.with-alpha(0.2); }
        Text { y: 50px; text: F.drag-label; font-size: 11px; color: Theme.text; horizontal-alignment: center; }
        if F.drag-count > 1: Rectangle {
            x: 40px; y: 0; width: 20px; height: 20px; border-radius: 10px; background: #ff3b30;
            Text { text: F.drag-count; color: white; font-size: 11px; font-weight: 700; }
        }
        if F.drop-copy: Rectangle {
            x: 40px; y: 34px; width: 18px; height: 18px; border-radius: 9px; background: #34c759;
            Text { text: "+"; color: white; font-size: 14px; font-weight: 700; }
        }
    }

    if F.in-search && F.search-busy && F.mode == 0: LoadingPill {
        x: cx + (cw - self.width) / 2; y: top-h + max(40px, (ch - self.height) / 2 - 40px);
    }
    if F.searching && F.search-focus && !F.sugg-hide && F.query != "" && F.mode == 0: SearchSuggestions {
        x: root.width - 9px - search-w; y: 48px; width: search-w;
    }
    if F.prog-on: ProgressCard { x: root.width - self.width - 16px; y: root.height - self.height - bot-h - 12px; }
    if F.vo-open: ViewOptions { x: root.width - self.width - 14px; y: 58px; }
    if F.ql-open: QuickLook { }
    if F.menu-open && !F.menu-native: MenuOverlay { }
    property <bool> menu-shown: F.menu-open;
    changed menu-shown => { if !self.menu-shown { F.menu-closed(); } }
    if F.custom-open: CustomizePanel { }
    if F.goto-open: GotoPanel { }
    if F.prefs-open: PrefsPanel { }
    if F.rn-open: RenamePanel { }
    if F.ss-open: SaveSearchPanel { }
    if F.tb-open: ToolbarPanel { }
    if F.cs-open: ConnectPanel { }

    clip := TextInput { visible: false; width: 0; height: 0; }
    public function copy-text(t: string) { clip.text = t; clip.select-all(); clip.copy(); }
    public function focus-keys() { keys.focus(); }

    if F.alert != "": AlertSheet { }
}
