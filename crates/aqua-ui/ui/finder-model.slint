import { Theme, Glyphs } from "common.slint";

export struct FItem {
    name: string, path: string, is-dir: bool,
    kind: int, ext: string, size: string, modified: string, kind-label: string,
    selected: bool, thumb: image, has-thumb: bool, snippet: string,
    tint: color, has-tint: bool, symbol: string, tags: [color], dim: bool, cut: bool,
    depth: int, can-expand: bool, expanded: bool, info: string, created: string, opened: string, alias: bool,
}
export struct FPlace { label: string, path: string, icon: string, header: string, eject: bool, dot: color, is-tag: bool, collapsed: bool, section: string }
export struct FColumn { path: string, items: [FItem], active: bool }
export struct FMenuItem { label: string, id: string, shortcut: string, enabled: bool, separator: bool, checked: bool, sub: bool }
export struct FKV { k: string, v: string }
export struct FTagDef { name: string, color: color, on: bool }
export struct FRow { header: string, start: int, count: int }
export struct FTab { title: string, path: string }
export struct FCrumb { label: string, path: string, icon: string }
export struct FLCol { key: int, title: string, x: length, w: length, right: bool }
export struct FOpt { id: string, label: string, on: bool }
export struct FSpot { x: length, y: length }
export struct FCrit { attr: int, op: int, value: string, unit: int, ops: [string], units: [string], has-value: bool }

