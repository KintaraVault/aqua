    out property <image> i-back: @image-url("icons/f-back.svg");
    out property <image> i-forward: @image-url("icons/f-forward.svg");
    /// Filled sidebar symbols of the Aqua style.
    public pure function aqua-glyph(n: string) -> image {
        if n == "apps" { return @image-url("icons/fa-apps.svg"); }
        if n == "shared" { return @image-url("icons/fa-shared.svg"); }
        if n == "recents" { return @image-url("icons/fa-recents.svg"); }
        if n == "desktop" { return @image-url("icons/fa-desktop.svg"); }
        if n == "docs" { return @image-url("icons/fa-docs.svg"); }
        if n == "downloads" { return @image-url("icons/fa-downloads.svg"); }
        if n == "home" { return @image-url("icons/fa-home.svg"); }
        if n == "computer" { return @image-url("icons/fa-computer.svg"); }
        if n == "disk" { return @image-url("icons/fa-disk.svg"); }
        if n == "network" { return @image-url("icons/fa-network.svg"); }
        if n == "trash" { return @image-url("icons/fa-trash.svg"); }
        if n == "pictures" { return @image-url("icons/fa-pictures.svg"); }
        if n == "music" { return @image-url("icons/fa-music.svg"); }
        if n == "movies" { return @image-url("icons/fa-movies.svg"); }
        if n == "cloud" { return @image-url("icons/fa-cloud.svg"); }
        if n == "smart" { return @image-url("icons/fa-smart.svg"); }
        if n == "terminal" { return @image-url("icons/fa-terminal.svg"); }
        if n == "copy" { return @image-url("icons/f-copy.svg"); }
        return @image-url("icons/fa-folder.svg");
    }
    public pure function glyph(n: string) -> image {
        if n == "apps" { return @image-url("icons/f-apps.svg"); }
        if n == "shared" { return @image-url("icons/f-shared.svg"); }
        if n == "recents" { return @image-url("icons/f-recents.svg"); }
        if n == "desktop" { return @image-url("icons/f-desktop.svg"); }
        if n == "docs" { return @image-url("icons/f-docs.svg"); }
        if n == "downloads" { return @image-url("icons/f-downloads.svg"); }
        if n == "home" { return @image-url("icons/f-home.svg"); }
        if n == "computer" { return @image-url("icons/f-computer.svg"); }
        if n == "disk" { return @image-url("icons/f-disk.svg"); }
        if n == "network" { return @image-url("icons/f-network.svg"); }
        if n == "trash" { return @image-url("icons/f-trash.svg"); }
        if n == "pictures" { return @image-url("icons/f-pictures.svg"); }
        if n == "music" { return @image-url("icons/f-music.svg"); }
        if n == "movies" { return @image-url("icons/f-movies.svg"); }
        if n == "cloud" { return @image-url("icons/f-cloud.svg"); }
        if n == "smart" { return @image-url("icons/f-smart.svg"); }
        if n == "terminal" { return @image-url("icons/f-terminal.svg"); }
        if n == "copy" { return @image-url("icons/f-copy.svg"); }
        return @image-url("icons/f-folder.svg");
    }
    public pure function menu-has-icon(id: string) -> bool {
        return id == "open" || id == "open-with" || id == "open-window" || id == "trash" || id == "info" || id == "rename"
            || id == "compress" || id == "duplicate" || id == "alias" || id == "quicklook" || id == "copy" || id == "paste"
            || id == "cut" || id == "share" || id == "tags-menu" || id == "new-folder" || id == "reveal" || id == "terminal"
            || id == "new-window" || id == "customize" || id == "put-back" || id == "delete-now" || id == "empty-trash"
            || id == "hidden" || id == "preview" || id == "goto" || id == "sort-reverse" || id == "mail" || id == "copy-path"
            || id == "remove-place" || id == "eject" || id == "new-tab" || id == "open-tab" || id == "show-original"
            || id == "add-sidebar" || id == "view-options" || id == "rename-multi" || id == "new-folder-sel" || id == "sort-menu"
            || id == "group-menu" || id == "info-window" || id == "connect" || id == "undo" || id == "redo" || id == "move-here"
            || id == "select-all" || id == "share-menu" || id == "open-with-menu";
    }
    public pure function menu-icon(id: string) -> image {
        if id == "open" || id == "open-with" || id == "open-with-menu" { return @image-url("icons/m-open.svg"); }
        if id == "new-tab" || id == "open-tab" { return @image-url("icons/m-window.svg"); }
        if id == "show-original" { return @image-url("icons/f-folder.svg"); }
        if id == "add-sidebar" { return @image-url("icons/f-plus.svg"); }
        if id == "view-options" { return @image-url("icons/m-sidebar-right.svg"); }
        if id == "rename-multi" { return @image-url("icons/m-rename.svg"); }
        if id == "new-folder-sel" { return @image-url("icons/m-folder-plus.svg"); }
        if id == "sort-menu" { return @image-url("icons/m-sort.svg"); }
        if id == "group-menu" { return @image-url("icons/f-group.svg"); }
        if id == "info-window" { return @image-url("icons/f-info.svg"); }
        if id == "connect" { return @image-url("icons/f-network.svg"); }
        if id == "undo" || id == "redo" { return @image-url("icons/m-goto.svg"); }
        if id == "move-here" { return @image-url("icons/m-paste.svg"); }
        if id == "select-all" { return @image-url("icons/f-icons.svg"); }
        if id == "share-menu" { return @image-url("icons/f-share.svg"); }
        if id == "open-window" || id == "new-window" { return @image-url("icons/m-window.svg"); }
        if id == "trash" || id == "empty-trash" { return @image-url("icons/f-trash.svg"); }
        if id == "delete-now" { return @image-url("icons/m-xbin.svg"); }
        if id == "info" { return @image-url("icons/f-info.svg"); }
        if id == "rename" { return @image-url("icons/m-rename.svg"); }
        if id == "compress" { return @image-url("icons/m-compress.svg"); }
        if id == "duplicate" { return @image-url("icons/m-duplicate.svg"); }
        if id == "alias" { return @image-url("icons/m-alias.svg"); }
        if id == "quicklook" { return @image-url("icons/m-eye.svg"); }
        if id == "hidden" { return @image-url("icons/m-eye-slash.svg"); }
        if id == "copy" || id == "copy-path" { return @image-url("icons/f-copy.svg"); }
        if id == "paste" { return @image-url("icons/m-paste.svg"); }
        if id == "cut" { return @image-url("icons/m-cut.svg"); }
        if id == "share" { return @image-url("icons/f-share.svg"); }
        if id == "tags-menu" { return @image-url("icons/f-tag.svg"); }
        if id == "new-folder" { return @image-url("icons/m-folder-plus.svg"); }
        if id == "reveal" { return @image-url("icons/f-folder.svg"); }
        if id == "terminal" { return @image-url("icons/f-terminal.svg"); }
        if id == "customize" { return @image-url("icons/m-brush.svg"); }
        if id == "put-back" { return @image-url("icons/m-putback.svg"); }
        if id == "preview" { return @image-url("icons/m-sidebar-right.svg"); }
        if id == "goto" { return @image-url("icons/m-goto.svg"); }
        if id == "sort-reverse" { return @image-url("icons/m-sort.svg"); }
        if id == "mail" { return @image-url("icons/m-mail.svg"); }
        if id == "eject" { return @image-url("icons/f-eject.svg"); }
        return @image-url("icons/f-xmark.svg");
    }
    public pure function cell(it: FItem, key: int) -> string {
        if key == 1 { return it.kind-label; }
        if key == 2 { return it.modified; }
        if key == 3 { return it.size; }
        if key == 4 { return it.created; }
        if key == 5 { return it.opened; }
        return "";
    }
}

export component FolderIcon inherits Rectangle {
    in property <length> s: 64px;
    in property <color> tint: Theme.aqua ? #6f8dfb : #5ebcf7;
    in property <string> symbol;
    /// Hovered / selected: the Aqua folder opens a little (the sheet inside rises, the
    /// front flap dips).
    in property <bool> hot;
    width: s; height: s;
    property <color> back: tint.darker(18%);
    if !Theme.aqua: Rectangle {
        Rectangle { x: s * 0.04; y: s * 0.13; width: s * 0.40; height: s * 0.16; border-radius: s * 0.05; background: back; }
        Rectangle { x: s * 0.04; y: s * 0.19; width: s * 0.92; height: s * 0.64; border-radius: s * 0.06; background: back; }
        Rectangle {
            x: s * 0.04; y: s * 0.29; width: s * 0.92; height: s * 0.56; border-radius: s * 0.06;
            background: @linear-gradient(180deg, tint.brighter(14%) 0%, tint 100%);
            drop-shadow-blur: s * 0.03; drop-shadow-color: #0000001c; drop-shadow-offset-y: -0.5px;
            Rectangle { y: 0; height: max(1px, s * 0.012); x: parent.border-radius; width: parent.width - 2 * parent.border-radius; background: #ffffff80; }
            if symbol != "": Text {
                text: symbol; font-size: s * 0.27; color: tint.darker(38%).with-alpha(0.78);
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
    // Aqua: a soft 3D folder — a deeper back plate with its tab, a sheet of paper and a
    // glossy front flap with a lit rim and a grounded shadow.
    if Theme.aqua: Rectangle {
        property <color> deep: tint.darker(30%);
        property <length> hair: max(0.5px, s * 0.008);
        // back plate + tab
        Rectangle {
            x: s * 0.07; y: s * 0.14; width: s * 0.36; height: s * 0.16; border-radius: s * 0.07;
            background: @linear-gradient(180deg, tint.darker(6%) 0%, deep 100%);
        }
        Rectangle {
            x: s * 0.07; y: s * 0.19; width: s * 0.86; height: s * 0.62; border-radius: s * 0.09;
            background: @linear-gradient(180deg, tint.darker(10%) 0%, deep 100%);
            border-width: hair; border-color: @linear-gradient(180deg, #ffffff55 0%, #ffffff00 30%);
        }
        // the sheet inside
        Rectangle {
            x: s * 0.14; y: hot ? s * 0.155 : s * 0.235; width: s * 0.72; height: s * 0.36; border-radius: s * 0.04;
            background: @linear-gradient(180deg, #ffffff 0%, #e9ecf4 100%);
            drop-shadow-blur: s * 0.03; drop-shadow-color: #0000002e; drop-shadow-offset-y: s * 0.01;
            animate y { duration: 180ms; easing: ease-out; }
            Rectangle { x: s * 0.07; y: s * 0.07; width: parent.width - s * 0.14; height: max(1px, s * 0.016); background: #c9cfdc; }
            Rectangle { x: s * 0.07; y: s * 0.12; width: parent.width - s * 0.26; height: max(1px, s * 0.016); background: #d6dbe6; }
        }
        // front flap
        Rectangle {
            x: s * 0.07; y: hot ? s * 0.34 : s * 0.305; width: s * 0.86; height: hot ? s * 0.50 : s * 0.535;
            border-radius: s * 0.09;
            background: @linear-gradient(180deg, tint.brighter(24%) 0%, tint.brighter(6%) 45%, tint 100%);
            border-width: hair;
            border-color: @linear-gradient(180deg, #ffffffb3 0%, #ffffff33 35%, #ffffff14 80%, #00000014 100%);
            drop-shadow-blur: s * 0.07; drop-shadow-offset-y: s * 0.03; drop-shadow-color: deep.darker(40%).with-alpha(0.38);
            animate y, height { duration: 180ms; easing: ease-out; }
            // glossy light along the top of the flap
            Rectangle {
                x: s * 0.03; y: hair; width: parent.width - s * 0.06; height: parent.height * 0.42;
                border-radius: s * 0.07;
                background: @linear-gradient(180deg, #ffffff40 0%, #ffffff12 55%, #ffffff00 100%);
            }
            // shade toward the bottom edge
            Rectangle {
                y: parent.height * 0.62; height: parent.height * 0.38; border-radius: parent.border-radius;
                background: @linear-gradient(180deg, #00000000 0%, #0000001a 100%);
            }
            if symbol != "": Text {
                text: symbol; font-size: s * 0.25; color: #ffffffd0;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

export component FileIcon inherits Rectangle {
    in property <FItem> item;
    in property <length> s: 64px;
    in property <bool> big-text: false;
    in property <bool> hot;
    width: s; height: s;
    property <float> ar: item.thumb.width > 0 ? item.thumb.width / max(1, item.thumb.height) : 1;
    if item.kind == 0: FolderIcon { s: root.s; tint: item.has-tint ? item.tint : (Theme.aqua ? #6f8dfb : #5ebcf7); symbol: item.symbol; hot: root.hot; }
    if item.kind == 9: Rectangle {
        width: s * 0.86; height: s * 0.5; border-radius: s * 0.1;
        background: @linear-gradient(180deg, #e9e9ec 0%, #b9b9bf 100%);
        border-width: 0.5px; border-color: #00000030;
        drop-shadow-blur: s * 0.04; drop-shadow-color: #00000030; drop-shadow-offset-y: s * 0.02;
        Rectangle { x: parent.width * 0.76; width: s * 0.06; height: s * 0.06; border-radius: s * 0.03; background: #3ddc5c; }
    }
    if (item.kind == 5 || (item.kind == 2 && item.has-thumb)) && item.kind != 0: Rectangle {
        width: ar >= 1 ? s : s * ar; height: ar >= 1 ? s / ar : s;
        border-radius: item.kind == 5 ? 0 : max(2px, s * 0.04);
        clip: item.kind != 5;
        drop-shadow-blur: item.kind == 5 ? 0 : s * 0.04; drop-shadow-color: item.kind == 5 ? transparent : #00000038; drop-shadow-offset-y: item.kind == 5 ? 0 : 1px;
        background: item.kind == 5 ? transparent : white;
        Image { source: item.thumb; width: 100%; height: 100%; image-fit: item.kind == 5 ? contain : cover; }
    }
    if item.kind != 0 && item.kind != 5 && item.kind != 9 && !(item.kind == 2 && item.has-thumb): page := Rectangle {
        width: s * 0.74; height: s * 0.94; border-radius: max(1.5px, s * 0.03);
        background: Theme.dark ? #f4f4f6 : white;
        border-width: 0.5px; border-color: #0000002e;
        drop-shadow-blur: s * 0.03; drop-shadow-color: #00000026; drop-shadow-offset-y: 0.5px;
        clip: true;
        if item.has-thumb: Image { source: item.thumb; width: 100%; height: 100%; image-fit: cover; }
        if !item.has-thumb && item.snippet != "": Text {
            x: page.width * 0.09; y: page.height * 0.07; width: page.width * 0.82; height: page.height * 0.86;
            text: item.snippet; font-size: max(1.2px, s * 0.034); color: #333;
            wrap: word-wrap; overflow: TextOverflow.clip; font-family: "DejaVu Sans Mono";
        }
        Path {
            x: page.width - s * 0.2; y: 0; width: s * 0.2; height: s * 0.2;
            viewbox-width: 10; viewbox-height: 10;
            commands: "M0 0 L10 10 L1.5 10 Q0 10 0 8.5 Z";
            fill: @linear-gradient(225deg, #ffffff 0%, #d9d9de 100%); stroke: #00000024; stroke-width: 0.5px;
        }
        Path { x: page.width - s * 0.2; y: 0; width: s * 0.2; height: s * 0.2; viewbox-width: 10; viewbox-height: 10; commands: "M0 0 L10 0 L10 10 Z"; fill: Theme.dark ? #1f1f21 : white; }
        if !item.has-thumb && item.snippet == "": VerticalLayout {
            alignment: center; spacing: s * 0.04;
            Image {
                height: s * 0.32;
                source: item.kind == 2 ? F.glyph("pictures") : item.kind == 3 ? F.glyph("music") : item.kind == 4 ? F.glyph("movies") : item.kind == 7 ? F.i-group : F.glyph("docs");
                colorize: item.kind == 2 ? #34c759 : item.kind == 3 ? #ff2d55 : item.kind == 4 ? #af52de : item.kind == 7 ? #8e8e93 : item.kind == 8 ? #e5463b : #a0a0a8;
            }
            if item.ext != "" && s >= 40px: Text {
                text: item.ext; horizontal-alignment: center; font-size: max(6px, s * 0.11); font-weight: 700;
                color: item.kind == 8 ? #e5463b : #8e8e93;
            }
        }
    }
    if item.alias: Rectangle {
        x: s * 0.06; y: s * 0.7; width: max(7px, s * 0.24); height: self.width; border-radius: self.width * 0.22;
        background: white; border-width: 0.5px; border-color: #00000059;
        Path { width: parent.width * 0.62; height: parent.height * 0.62; viewbox-width: 10; viewbox-height: 10;
            commands: "M2 8 L7.5 2.5 M3.8 2.5 L7.5 2.5 L7.5 6.2"; stroke: #1c1c1e; stroke-width: max(1px, s * 0.022); fill: transparent; }
    }
}

export component TagDots inherits HorizontalLayout {
    in property <[color]> tags;
    spacing: -3px;
    alignment: center;
    for c in tags: Rectangle { width: 9px; height: 9px; border-radius: 4.5px; background: c; border-width: 1px; border-color: Theme.window-bg; }
}

