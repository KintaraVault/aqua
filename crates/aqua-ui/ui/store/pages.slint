import { Theme, Segmented, Field, PopupSelect } from "../common.slint";
import { SG } from "glyphs.slint";
import { SApp, SHero, SShelf, SUpd, AS } from "model.slint";
import { Hairline, AppIcon, GetButton, Link, Badge, Stars, RoundButton, ShelfHeader, AppRow, AppGrid, HeroCard, Spinner, Pill } from "parts.slint";

component Loading inherits Rectangle {
    height: 220px;
    Spinner { size: 24px; }
}

component Problem inherits Rectangle {
    in property <string> text;
    height: 260px;
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text { text: @tr("Can’t Connect"); font-size: 19px; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
        Text { text: root.text; font-size: 13px; color: Theme.text-secondary; horizontal-alignment: center; wrap: word-wrap; }
        HorizontalLayout { alignment: center; Pill { text: @tr("Try Again"); clicked => { AS.retry(); } } }
    }
}

component Empty inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <image> glyph;
    height: 300px;
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout { alignment: center; Image { width: 56px; height: 56px; source: root.glyph; colorize: Theme.text-tertiary; } }
        Text { text: root.title; font-size: 19px; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
        Text { text: root.text; font-size: 13px; color: Theme.text-secondary; horizontal-alignment: center; wrap: word-wrap; }
    }
}

component Scroller inherits Flickable {
    in property <bool> watch-end: false;
    changed content-y => {
        AS.scroll-y = -self.content-y;
        if watch-end && self.content-height + self.content-y < self.height + 400px { AS.load-more(); }
    }
    init => { AS.scroll-y = 0; }
}

component ShelfBlock inherits VerticalLayout {
    in property <SShelf> shelf;
    in property <int> cols;
    spacing: 6px;
    ShelfHeader {
        title: shelf.title;
        subtitle: shelf.subtitle;
        see-all: shelf.id != "";
        clicked => { AS.open-feed(shelf.id, shelf.title); }
    }
    AppGrid { apps: shelf.apps; cols: root.cols; }
}

export component HomePage inherits Rectangle {
    property <length> pad: 28px;
    property <int> cols: self.width > 940px ? 3 : 2;
    property <int> per: self.width > 860px ? 2 : 1;
    property <length> gap: 18px;
    property <length> card-w: (self.width - 2 * pad - (per - 1) * gap) / per;
    property <int> hero-index: 0;
    property <int> hero-max: max(0, AS.heroes.length - per);
    sc := Scroller {
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: sc.width;
            padding-left: pad;
            padding-right: pad;
            padding-top: 60px;
            padding-bottom: 36px;
            spacing: 30px;
            if AS.heroes.length > 0: Rectangle {
                height: 316px;
                clip: true;
                for h[i] in AS.heroes: HeroCard {
                    x: (i - root.hero-index) * (root.card-w + root.gap);
                    animate x { duration: 350ms; easing: ease-in-out; }
                    width: root.card-w;
                    height: 316px;
                    hero: h;
                }
                if root.hero-index > 0: RoundButton {
                    x: 10px;
                    y: (parent.height - self.height) / 2 - 30px;
                    glyph: SG.back;
                    clicked => { root.hero-index = max(0, root.hero-index - root.per); }
                }
                if root.hero-index < root.hero-max: RoundButton {
                    x: parent.width - self.width - 10px;
                    y: (parent.height - self.height) / 2 - 30px;
                    glyph: SG.forward;
                    clicked => { root.hero-index = min(root.hero-max, root.hero-index + root.per); }
                }
            }
            if AS.subtitle != "" && AS.heroes.length == 0 && AS.shelves.length > 0: Text {
                text: AS.subtitle;
                font-size: 13px;
                color: Theme.text-secondary;
            }
            for s in AS.shelves: ShelfBlock { shelf: s; cols: root.cols; }
            if AS.loading && AS.shelves.length == 0: Loading {}
            if !AS.loading && AS.error != "" && AS.shelves.length == 0: Problem { text: AS.error; }
        }
    }
}

export component CategoriesPage inherits Rectangle {
    property <length> pad: 28px;
    property <int> cols: self.width > 900px ? 3 : 2;
    property <length> gap: 22px;
    property <length> cw: (self.width - 2 * pad - (cols - 1) * gap) / cols;
    property <int> rows: ceil(AS.cats.length / cols);
    sc := Scroller {
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: sc.width;
            padding-left: pad;
            padding-right: pad;
            padding-top: 54px;
            padding-bottom: 36px;
            spacing: 26px;
            Rectangle {
                height: root.rows * 48px;
                for c[i] in AS.cats: Rectangle {
                    x: mod(i, root.cols) * (root.cw + root.gap);
                    y: floor(i / root.cols) * 48px;
                    width: root.cw;
                    height: 48px;
                    background: cta.pressed ? Theme.hover : transparent;
                    Image {
                        x: 2px;
                        width: 22px;
                        height: 22px;
                        source: SG.named(c.glyph);
                        colorize: c.tint;
                    }
                    Text {
                        x: 34px;
                        width: parent.width - 34px;
                        text: c.title;
                        font-size: 14px;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Hairline { x: 34px; y: parent.height - 1px; width: parent.width - 34px; }
                    cta := TouchArea { mouse-cursor: pointer; clicked => { AS.open-category(c.id); } }
                }
            }
            Hairline {}
            for s in AS.shelves: ShelfBlock { shelf: s; cols: root.cols == 3 ? 2 : 1; }
            if AS.loading && AS.shelves.length == 0: Loading {}
        }
    }
}

export component ListPage inherits Rectangle {
    property <length> pad: 28px;
    property <int> cols: self.width > 760px ? 2 : 1;
    sc := Scroller {
        watch-end: AS.list-more && !AS.list-loading;
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: sc.width;
            padding-left: pad;
            padding-right: pad;
            padding-top: 56px;
            padding-bottom: 36px;
            spacing: 14px;
            VerticalLayout {
                spacing: 2px;
                Text { text: AS.title; font-size: 26px; font-weight: 800; color: Theme.text; overflow: elide; }
                if AS.subtitle != "": Text { text: AS.subtitle; font-size: 13px; color: Theme.text-secondary; overflow: elide; }
            }
            AppGrid { apps: AS.list; cols: root.cols; gap: 28px; }
            if AS.list-loading || (AS.loading && AS.list.length == 0): Loading { height: 120px; }
            if !AS.loading && AS.error != "" && AS.list.length == 0: Problem { text: AS.error; }
            if !AS.loading && AS.error == "" && AS.list.length == 0: Empty {
                title: @tr("Nothing Here Yet");
                text: @tr("No apps were found in this collection.");
                glyph: SG.categories;
            }
        }
    }
}

export component SearchPage inherits Rectangle {
    property <length> pad: 28px;
    property <int> cols: self.width > 760px ? 2 : 1;
    sc := Scroller {
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: sc.width;
            padding-left: pad;
            padding-right: pad;
            padding-top: 56px;
            padding-bottom: 36px;
            spacing: 14px;
            Text { text: AS.title; font-size: 26px; font-weight: 800; color: Theme.text; overflow: elide; }
            if AS.results.length > 0: ShelfHeader { title: @tr("Apps"); see-all: false; }
            if AS.results.length > 0: AppGrid { apps: AS.results; cols: root.cols; gap: 28px; }
            if AS.packages.length > 0: ShelfHeader {
                title: @tr("Packages");
                subtitle: @tr("Command-line tools, libraries and other software from your system’s repositories");
                see-all: false;
            }
            if AS.packages.length > 0: AppGrid { apps: AS.packages; cols: root.cols; gap: 28px; icon-size: 40px; }
            if AS.searching: Loading { height: 140px; }
            if !AS.searching && AS.results.length == 0 && AS.packages.length == 0: Empty {
                title: @tr("No Results");
                text: @tr("Check the spelling or try a new search.");
                glyph: SG.search;
            }
        }
    }
}

component Collapsible inherits Rectangle {
    in property <string> text;
    in property <int> lines: 3;
    in property <length> font-size: 13px;
    property <bool> open: false;
    property <length> line-h: font-size * 1.36;
    property <bool> long: body.preferred-height > lines * line-h + 2px;
    height: open || !long ? body.preferred-height : lines * line-h;
    clip: true;
    body := Text {
        y: 0;
        width: parent.width;
        text: root.text;
        font-size: root.font-size;
        color: Theme.text;
        wrap: word-wrap;
        vertical-alignment: top;
    }
    if root.long && !root.open: Rectangle {
        x: parent.width - 70px;
        y: parent.height - root.line-h;
        width: 70px;
        height: root.line-h;
        background: @linear-gradient(90deg, Theme.window-bg.with-alpha(0) 0%, Theme.window-bg 30%);
        Link {
            x: parent.width - self.preferred-width;
            text: @tr("more");
            font-size: root.font-size;
            clicked => { root.open = true; }
        }
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> link;
    callback link-clicked();
    padding-top: 20px;
    padding-bottom: 22px;
    spacing: 12px;
    Rectangle {
        height: 26px;
        Text { x: 0; text: root.title; font-size: 19px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
        if root.link != "": Link {
            x: parent.width - self.preferred-width;
            text: root.link;
            font-size: 14px;
            clicked => { root.link-clicked(); }
        }
    }
    @children
}

export component AppPage inherits Rectangle {
    property <length> pad: 28px;
    property <int> cols: self.width > 940px ? 3 : 2;
    property <int> info-cols: self.width > 900px ? 3 : 2;
    property <length> shot-h: self.width > 900px ? 300px : 230px;
    property <bool> busy: AS.detail.app.state == 3 || AS.detail.app.state == 4 || AS.detail.app.state == 6;
    sc := Scroller {
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: sc.width;
            padding-left: pad;
            padding-right: pad;
            padding-top: 50px;
            padding-bottom: 36px;
            spacing: 0px;
            HorizontalLayout {
                padding-bottom: 20px;
                spacing: 22px;
                AppIcon { app: AS.detail.app; size: 136px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text { text: AS.detail.app.name; font-size: 26px; font-weight: 800; color: Theme.text; overflow: elide; }
                        if AS.detail.app.verified: VerticalLayout {
                            alignment: center;
                            Image { width: 18px; height: 18px; source: SG.seal; colorize: Theme.accent; }
                        }
                    }
                    Text { text: AS.detail.subtitle; font-size: 15px; color: Theme.text-secondary; overflow: elide; }
                    if AS.detail.developer != "": HorizontalLayout {
                        alignment: start;
                        Link { text: AS.detail.developer; clicked => { AS.open-developer(AS.detail.developer); } }
                    }
                    Rectangle { height: 10px; }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            GetButton {
                                filled: true;
                                large: true;
                                state: AS.detail.app.state;
                                progress: AS.detail.app.progress;
                                clicked => { AS.primary(AS.detail.app.key); }
                                cancel => { AS.cancel(AS.detail.app.key); }
                            }
                        }
                        if root.busy: VerticalLayout {
                            alignment: center;
                            Text { text: AS.detail.app.status; font-size: 12px; color: Theme.text-secondary; overflow: elide; max-width: 260px; }
                        }
                        if !root.busy && AS.sources.length > 1: VerticalLayout {
                            alignment: center;
                            PopupSelect {
                                bezel: true;
                                items: AS.sources;
                                current <=> AS.source-index;
                                changed(i) => { AS.source-changed(i); }
                            }
                        }
                        if !root.busy && AS.sources.length <= 1 && AS.detail.source-label != "": VerticalLayout {
                            alignment: center;
                            Badge { text: AS.detail.source-label; }
                        }
                        VerticalLayout {
                            alignment: center;
                            em := RoundButton {
                                plain: true;
                                size: 28px;
                                glyph: SG.ellipsis;
                                clicked => { AS.page-menu(self.absolute-position.x, self.absolute-position.y + self.height + 4px); }
                            }
                        }
                    }
                }
            }
            Hairline {}
            if AS.strip.length > 0: HorizontalLayout {
                height: 84px;
                for c[i] in AS.strip: Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    preferred-width: 1px;
                    VerticalLayout {
                        alignment: center;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 3px;
                        Text { height: 13px; text: c.label; font-size: 10px; font-weight: 600; letter-spacing: 0.3px; color: Theme.text-tertiary; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                        if c.glyph == "": Text { height: 26px; text: c.value; font-size: 19px; font-weight: 700; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                        if c.glyph != "": HorizontalLayout {
                            height: 26px;
                            alignment: center;
                            Image { width: 22px; height: 22px; source: SG.named(c.glyph); colorize: Theme.text-secondary; }
                        }
                        if c.stars: HorizontalLayout { height: 15px; alignment: center; Stars { value: AS.detail.stars; size: 10px; } }
                        if !c.stars: Text { height: 15px; text: c.sub; font-size: 12px; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    }
                    if i < AS.strip.length - 1: Rectangle {
                        x: parent.width - 1px;
                        y: (parent.height - 38px) / 2;
                        width: 1px;
                        height: 38px;
                        background: Theme.separator;
                    }
                    if c.link != "": TouchArea { mouse-cursor: pointer; clicked => { AS.menu-action(c.link); } }
                }
            }
            if AS.strip.length > 0: Hairline {}
            if !AS.detail.loaded: Loading { height: 160px; }
            if AS.detail.has-releases: Section {
                title: @tr("What’s New");
                link: AS.releases.length > 1 ? @tr("Version History") : "";
                link-clicked => { AS.open-versions(); }
                HorizontalLayout {
                    spacing: 28px;
                    Collapsible { text: AS.detail.notes != "" ? AS.detail.notes : @tr("Bug fixes and improvements."); lines: 2; horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        Text { text: AS.detail.updated; font-size: 13px; color: Theme.text-secondary; horizontal-alignment: right; }
                        Text { text: AS.detail.version != "" ? @tr("Version {}", AS.detail.version) : ""; font-size: 13px; color: Theme.text-secondary; horizontal-alignment: right; }
                    }
                }
            }
            if AS.detail.has-releases: Hairline {}
            if AS.shots.length > 0: Section {
                title: @tr("Preview");
                Rectangle {
                    height: root.shot-h;
                    sf := Flickable {
                        content-width: shots.preferred-width;
                        interactive: true;
                        shots := HorizontalLayout {
                            spacing: 14px;
                            for s[i] in AS.shots: Rectangle {
                                width: root.shot-h * s.ratio;
                                height: root.shot-h;
                                border-radius: 12px;
                                clip: true;
                                background: Theme.card-bg;
                                border-width: 0.5px;
                                border-color: Theme.separator;
                                if s.loaded: Image { width: 100%; height: 100%; source: s.img; image-fit: cover; }
                                if !s.loaded: Spinner {}
                                TouchArea { mouse-cursor: pointer; clicked => { AS.open-shot(i); } }
                            }
                        }
                    }
                    if sf.content-x < 0: RoundButton {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        glyph: SG.back;
                        clicked => { sf.content-x = min(0px, sf.content-x + sf.width * 0.8); }
                    }
                    if sf.content-x > sf.width - sf.content-width + 1px: RoundButton {
                        x: parent.width - self.width - 8px;
                        y: (parent.height - self.height) / 2;
                        glyph: SG.forward;
                        clicked => { sf.content-x = max(sf.width - sf.content-width, sf.content-x - sf.width * 0.8); }
                    }
                }
            }
            if AS.shots.length > 0: Hairline {}
            if AS.detail.description != "": Section {
                title: AS.detail.has-releases || AS.shots.length > 0 ? @tr("Description") : @tr("About This App");
                Collapsible { text: AS.detail.description; lines: 5; }
                if AS.detail.developer != "" || AS.detail.homepage != "": HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    if AS.detail.developer != "": Link { text: AS.detail.developer; clicked => { AS.open-developer(AS.detail.developer); } }
                    if AS.detail.homepage != "": Link { text: @tr("Website"); clicked => { AS.open-url(AS.detail.homepage); } }
                }
            }
            if AS.detail.description != "": Hairline {}
            if AS.detail.has-ratings: Section {
                title: @tr("Ratings & Reviews");
                link: AS.reviews.length > 0 ? @tr("See All") : "";
                link-clicked => { AS.all-reviews(); }
                HorizontalLayout {
                    spacing: 26px;
                    alignment: start;
                    VerticalLayout {
                        alignment: start;
                        Text { text: AS.detail.rating; font-size: 54px; font-weight: 800; color: Theme.text-secondary; horizontal-alignment: center; }
                        Text { text: @tr("out of 5"); font-size: 13px; font-weight: 600; color: Theme.text-secondary; horizontal-alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        width: min(400px, parent.width - 140px);
                        for f[i] in AS.histogram: HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 60px;
                                height: 9px;
                                Stars { x: parent.width - self.width; value: 5 - i; size: 8px; tint: Theme.text-secondary; opacity: 0.85; }
                            }
                            Rectangle {
                                height: 4px;
                                y: 2px;
                                border-radius: 2px;
                                background: Theme.dark ? #ffffff1c : #00000014;
                                Rectangle { x: 0; width: parent.width * f; border-radius: 2px; background: Theme.text-secondary; }
                            }
                        }
                        HorizontalLayout {
                            padding-top: 4px;
                            Text { text: AS.detail.rating-count; font-size: 12px; color: Theme.text-secondary; horizontal-stretch: 1; }
                            if AS.detail.can-review: Link { text: @tr("Write a Review"); clicked => { AS.write-review(); } }
                        }
                    }
                }
                if AS.reviews.length > 0: Rectangle {
                    height: 176px;
                    rf := Flickable {
                        content-width: rv.preferred-width;
                        rv := HorizontalLayout {
                            spacing: 14px;
                            for r in AS.reviews: Rectangle {
                                width: 320px;
                                height: 176px;
                                border-radius: 14px;
                                background: Theme.card-bg;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: r.title; font-size: 14px; font-weight: 700; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                                        Text { text: r.date; font-size: 12px; color: Theme.text-secondary; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Stars { value: r.stars; size: 10px; tint: #ff9500; }
                                        Text { text: r.author; font-size: 12px; color: Theme.text-secondary; overflow: elide; horizontal-alignment: right; horizontal-stretch: 1; }
                                    }
                                    Text { height: 88px; text: r.body; font-size: 13px; color: Theme.text; wrap: word-wrap; overflow: elide; vertical-alignment: top; }
                                }
                            }
                        }
                    }
                }
                if AS.reviews.length == 0 && AS.detail.rating-count != "": Text {
                    text: @tr("No written reviews yet.");
                    font-size: 13px;
                    color: Theme.text-secondary;
                }
            }
            if AS.detail.has-ratings: Hairline {}
            if AS.detail.has-perms: Section {
                title: @tr("Permissions");
                link: AS.detail.can-manage-perms ? @tr("Manage…") : "";
                link-clicked => { AS.manage-perms(); }
                Rectangle {
                    property <int> pc: root.width > 760px ? 2 : 1;
                    property <length> pw: (self.width - (pc - 1) * 24px) / pc;
                    height: ceil(AS.perms.length / pc) * 52px;
                    for p[i] in AS.perms: Rectangle {
                        x: mod(i, parent.pc) * (parent.pw + 24px);
                        y: floor(i / parent.pc) * 52px;
                        width: parent.pw;
                        height: 52px;
                        Image {
                            x: 0;
                            width: 22px;
                            height: 22px;
                            source: SG.named(p.glyph);
                            colorize: p.risky ? #ff9500 : Theme.accent;
                        }
                        VerticalLayout {
                            x: 36px;
                            width: parent.width - 36px;
                            alignment: center;
                            spacing: 1px;
                            Text { text: p.label; font-size: 13px; color: Theme.text; overflow: elide; }
                            Text { text: p.detail; font-size: 11px; color: Theme.text-secondary; overflow: elide; }
                        }
                    }
                }
            }
            if AS.detail.has-perms: Hairline {}
            if AS.info.length > 0: Section {
                title: @tr("Information");
                Rectangle {
                    property <length> iw: (self.width - (root.info-cols - 1) * 24px) / root.info-cols;
                    height: ceil(AS.info.length / root.info-cols) * 58px;
                    for c[i] in AS.info: Rectangle {
                        x: mod(i, root.info-cols) * (parent.iw + 24px);
                        y: floor(i / root.info-cols) * 58px;
                        width: parent.iw;
                        height: 58px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 2px;
                            Text { text: c.label; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
                            if c.link == "": Text { text: c.value; font-size: 13px; color: Theme.text; overflow: elide; }
                            if c.link != "": Link { text: c.value; clicked => { AS.open-url(c.link); } }
                            if c.sub != "": Text { text: c.sub; font-size: 11px; color: Theme.text-tertiary; overflow: elide; }
                        }
                        Hairline { y: parent.height - 8px; }
                    }
                }
                if AS.links.length > 0: HorizontalLayout {
                    spacing: 22px;
                    alignment: start;
                    for l in AS.links: HorizontalLayout {
                        spacing: 5px;
                        Link { text: l.value; clicked => { AS.open-url(l.link); } }
                        VerticalLayout { alignment: center; Image { width: 11px; height: 11px; source: SG.named(l.glyph); colorize: Theme.accent; } }
                    }
                }
            }
            for s in AS.related: VerticalLayout {
                padding-top: 4px;
                padding-bottom: 18px;
                spacing: 6px;
                Hairline {}
                Rectangle { height: 10px; }
                ShelfHeader {
                    title: s.title;
                    see-all: s.id != "";
                    clicked => { AS.open-feed(s.id, s.title); }
                }
                AppGrid { apps: s.apps; cols: root.cols; }
            }
        }
    }
}

component UpdateRow inherits Rectangle {
    in property <SUpd> u;
    in property <bool> separator: true;
    height: lay.preferred-height;
    lay := HorizontalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 14px;
        AppIcon { app: u.app; size: 64px; }
        VerticalLayout {
            spacing: 3px;
            alignment: start;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: u.app.name; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
                    Text {
                        text: (u.from != "" ? u.from + "  →  " : "") + u.to + (u.size != "" ? "  ·  " + u.size : "") + (u.date != "" ? "  ·  " + u.date : "");
                        font-size: 12px;
                        color: Theme.text-secondary;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    GetButton {
                        state: u.app.state;
                        progress: u.app.progress;
                        clicked => { AS.primary(u.app.key); }
                        cancel => { AS.cancel(u.app.key); }
                    }
                }
            }
            if u.notes != "": Collapsible { text: u.notes; lines: 2; font-size: 12px; }
            if u.app.status != "" && (u.app.state == 3 || u.app.state == 4): Text { text: u.app.status; font-size: 11px; color: Theme.text-tertiary; overflow: elide; }
        }
    }
    TouchArea {
        width: 64px;
        height: 64px;
        x: 0;
        y: 14px;
        mouse-cursor: pointer;
        clicked => { AS.open-app(u.app.key); }
    }
    if separator: Hairline { x: 78px; y: parent.height - 1px; width: parent.width - 78px; }
}

component SysRow inherits Rectangle {
    in property <SUpd> u;
    height: 30px;
    Text { x: 0; width: parent.width * 0.5; text: u.app.name; font-size: 12px; color: Theme.text; vertical-alignment: center; overflow: elide; }
    Text {
        x: parent.width * 0.5;
        width: parent.width * 0.5;
        text: (u.from != "" ? u.from + " → " : "") + u.to;
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
    }
    Hairline { y: parent.height - 1px; }
}

export component UpdatesPage inherits Rectangle {
    property <length> pad: 28px;
    property <bool> show-system: false;
    property <int> total: AS.updates.length + AS.system-updates.length;
    sc := Scroller {
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: sc.width;
            padding-left: pad;
            padding-right: pad;
            padding-top: 56px;
            padding-bottom: 36px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 12px;
                padding-bottom: 6px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: @tr("Updates"); font-size: 26px; font-weight: 800; color: Theme.text; }
                    Text { text: AS.checking ? @tr("Checking for updates…") : AS.last-check; font-size: 12px; color: Theme.text-secondary; }
                }
                if AS.checking: VerticalLayout { alignment: center; Spinner { size: 18px; } }
                if !AS.checking: VerticalLayout { alignment: center; Pill { text: @tr("Check Now"); clicked => { AS.check-updates(); } } }
                if root.total > 0: VerticalLayout {
                    alignment: center;
                    Pill {
                        primary: true;
                        enabled: !AS.updating-all;
                        text: AS.updating-all ? @tr("Updating…") : @tr("Update All");
                        clicked => { AS.update-all(); }
                    }
                }
            }
            if AS.updates.length > 0: ShelfHeader {
                title: @tr("Available");
                see-all: false;
            }
            for u[i] in AS.updates: UpdateRow { u: u; separator: i < AS.updates.length - 1; }
            if AS.system-updates.length > 0: VerticalLayout {
                padding-top: 18px;
                spacing: 6px;
                ShelfHeader {
                    title: @tr("System Packages");
                    subtitle: AS.system-updates.length == 1 ? @tr("1 package can be updated") : @tr("{} packages can be updated", AS.system-updates.length);
                    link: root.show-system ? @tr("Hide") : @tr("Show");
                    clicked => { root.show-system = !root.show-system; }
                }
                if root.show-system: VerticalLayout {
                    for u in AS.system-updates: SysRow { u: u; }
                }
            }
            if root.total == 0 && !AS.checking: Empty {
                title: @tr("Your Apps Are Up to Date");
                text: @tr("Updates for your apps and system appear here.");
                glyph: SG.checkmark;
                height: 240px;
            }
            if AS.recent.length > 0: VerticalLayout {
                padding-top: 22px;
                spacing: 0px;
                ShelfHeader { title: @tr("Updated Recently"); see-all: true; link: @tr("History"); clicked => { AS.open-history(); } }
                for u[i] in AS.recent: UpdateRow { u: u; separator: i < AS.recent.length - 1; }
            }
        }
    }
}

export component AccountPage inherits Rectangle {
    property <length> pad: 28px;
    sc := Scroller {
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: sc.width;
            padding-left: pad;
            padding-right: pad;
            padding-top: 56px;
            padding-bottom: 36px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 16px;
                padding-bottom: 10px;
                Rectangle {
                    width: 72px;
                    height: 72px;
                    border-radius: 36px;
                    clip: true;
                    background: Theme.dark ? #ffffff24 : #d6d7dc;
                    if AS.has-avatar: Image { width: 100%; height: 100%; source: AS.avatar; image-fit: cover; }
                    if !AS.has-avatar: Image { y: 12px; width: 60px; height: 60px; source: SG.person; colorize: white; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    Text { text: AS.user-name; font-size: 24px; font-weight: 800; color: Theme.text; overflow: elide; }
                    Text { text: AS.system-info; font-size: 13px; color: Theme.text-secondary; overflow: elide; }
                }
                VerticalLayout { alignment: center; Pill { text: @tr("History"); clicked => { AS.open-history(); } } }
                VerticalLayout { alignment: center; Pill { text: @tr("Settings"); clicked => { AS.open-settings(); } } }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: @tr("Installed"); font-size: 19px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                Text { text: AS.installed-count; font-size: 15px; color: Theme.text-tertiary; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Segmented { items: AS.filters; current <=> AS.filter; changed(i) => { AS.filter-changed(i); } }
                }
                VerticalLayout {
                    alignment: center;
                    Field {
                        width: 200px;
                        search: true;
                        placeholder: @tr("Filter");
                        text <=> AS.query;
                        edited(t) => { AS.query-edited(t); }
                    }
                }
            }
            for a[i] in AS.installed: Rectangle {
                height: 66px;
                AppIcon { x: 0; y: 7px; app: a; size: 52px; }
                VerticalLayout {
                    x: 64px;
                    width: parent.width - 64px - 150px;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text { text: a.name; font-size: 14px; color: Theme.text; overflow: elide; }
                        if a.badge != "": VerticalLayout { alignment: center; Badge { text: a.badge; tint: Theme.accent; } }
                    }
                    Text { text: a.detail; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
                }
                TouchArea {
                    width: parent.width - 150px;
                    mouse-cursor: pointer;
                    clicked => { AS.open-app(a.key); }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                            AS.app-menu(a.key, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                HorizontalLayout {
                    x: parent.width - 150px;
                    width: 150px;
                    alignment: end;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        GetButton {
                            state: a.state;
                            progress: a.progress;
                            clicked => { AS.primary(a.key); }
                            cancel => { AS.cancel(a.key); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        RoundButton {
                            plain: true;
                            size: 26px;
                            glyph: SG.ellipsis;
                            clicked => { AS.app-menu(a.key, self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
                        }
                    }
                }
                if i < AS.installed.length - 1: Hairline { x: 64px; y: parent.height - 1px; width: parent.width - 64px; }
            }
            if AS.loading && AS.installed.length == 0: Loading {}
            if !AS.loading && AS.installed.length == 0: Empty {
                title: @tr("No Apps");
                text: AS.query != "" ? @tr("No installed apps match your filter.") : @tr("Apps you install appear here.");
                glyph: SG.categories;
            }
        }
    }
}
